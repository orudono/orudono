function setCssVar(name, val) { document.documentElement.style.setProperty(name, val); }

function applyPreset(name) {
  let p = PRESETS[name]; if (!p) return;
  Object.entries(p).forEach(([k,v]) => { if (k.startsWith('--')) setCssVar(k,v); });
  syncThemePickers();
}

function syncThemeHex(colorId, hexId, cssVar) {
  let val = document.getElementById(colorId).value;
  document.getElementById(hexId).value = val;
  setCssVar(cssVar, val);
}

function applyThemeHex(input, cssVar) {
  let val = input.value.trim();
  let color = parseColorInput(val);
  if (!color) return;
  setCssVar(cssVar, color);
  // find companion color picker
  let row = input.parentElement;
  let cp = row.querySelector('input[type=color]');
  if (cp && /^#[0-9a-fA-F]{6}$/.test(color)) cp.value = color;
}

function syncThemePickers() {
  let st = getComputedStyle(document.documentElement);
  const map = {
    "tc-bg": ["tc-bg-hex", "--bg"],
    "tc-sidebar": ["tc-sidebar-hex", "--sidebar-bg"],
    "tc-topbar": ["tc-topbar-hex", "--topbar-bg"],
    "tc-card": ["tc-card-hex", "--card-bg"],
    "tc-editor": ["tc-editor-hex", "--editor-bg"],
    "tc-accent": ["tc-accent-hex", "--accent"],
    "tc-text": ["tc-text-hex", "--text-main"],
  };
  Object.entries(map).forEach(([colorId, [hexId, cssVar]]) => {
    let el = document.getElementById(colorId);
    let hexEl = document.getElementById(hexId);
    let val = st.getPropertyValue(cssVar).trim();
    if (el && /^#[0-9a-fA-F]{3,6}$/.test(val)) el.value = val;
    if (hexEl) hexEl.value = val;
  });
}

