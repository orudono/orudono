============================================================ */
function exportDeck() { document.getElementById("exportModal").classList.add("active"); }
function closeExportModal() { document.getElementById("exportModal").classList.remove("active"); }

function doExport(fmt) {
  saveNotesDeck();
  let kd = getKanjiDecks(), nd = getNotesDecks();
  let deck = kd[currentKanjiDeck] || { cards:[], name:"Deck" };
  let cards_arr = deck.cards || [];
  if (fmt === "json") {
    download("kanji_notes_v7.json", JSON.stringify({kanjiDecks:kd,notesDecks:nd},null,2), "application/json");
  } else if (fmt === "csv") {
    let rows = [["front","reading","back","color","known","tags"]];
    cards_arr.forEach(c => rows.push([c.front,c.reading||"",c.back,c.color,c.known,(c.tags||[]).join("|")]));
    download((deck.name||"deck")+".csv", rows.map(r=>r.map(v=>'"'+String(v||"").replace(/"/g,'""')+'"').join(",")).join("\n"), "text/csv");
  } else if (fmt === "tsv") {
    let rows = [["front","reading","back","color","known","tags"]];
    cards_arr.forEach(c => rows.push([c.front,c.reading||"",c.back,c.color,c.known,(c.tags||[]).join("|")]));
    download((deck.name||"deck")+".tsv", rows.map(r=>r.join("\t")).join("\n"), "text/tab-separated-values");
  } else if (fmt === "anki") {
    let rows = cards_arr.filter(c=>c.front!=="□").map(c => [c.front,(c.reading?c.reading+" · ":"")+c.back].map(v=>'"'+String(v||"").replace(/"/g,'""')+'"').join(","));
    download((deck.name||"deck")+"_anki.csv", rows.join("\n"), "text/csv");
  } else if (fmt === "html") {
    let htmlParts = nd.map((n,i)=>`<h2>${escHtml(n.name||"Note "+(i+1))}</h2>${n.content||""}`).join("<hr>");
    let full = `<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Notes</title>
<style>body{font-family:"MS Mincho",serif;max-width:800px;margin:40px auto;padding:0 20px;line-height:1.8}
.inline-note{background:#fffde7;border-bottom:2px dashed #f9a825;}</style>
</head><body>${htmlParts}</body></html>`;
    download("notes_export.html", full, "text/html");
  }
  closeExportModal();
}

function download(name, content, type) {
  let a = document.createElement("a"); a.href = URL.createObjectURL(new Blob([content],{type}));
  a.download = name; a.click();
}

function showImportMenu() { document.getElementById("importModal").classList.add("active"); }

function doImport(fmt) {
  let inp = document.createElement("input"); inp.type="file"; inp.accept = fmt==="json" ? ".json" : ".csv,.tsv,.txt";
  inp.onchange = () => {
    let f = inp.files[0]; if (!f) return;
    let reader = new FileReader();
    reader.onload = e => {
      try {
        if (fmt === "json") {
          let data = JSON.parse(e.target.result);
          if (data.kanjiDecks) { saveKanjiDecksRaw(data.kanjiDecks); _kanjiCache = data.kanjiDecks; }
          if (data.notesDecks) { saveNotesDecksRaw(data.notesDecks); _notesCache = data.notesDecks; }
          loadKanjiDeck(0);
          let nd = getNotesDecks();
          document.getElementById("editor").innerHTML = nd[0]?.content || "";
          updateTOC(); rebindNotes(); renderSidebar(); alert("✓ Import JSON thành công!");
        } else {
          let lines = e.target.result.split("\n").filter(Boolean);
          if (lines[0].toLowerCase().includes("front")) lines.shift();
          let decks = getKanjiDecks();
          let newCards = lines.map(line => {
            let parts = line.split(fmt==="tsv"?"\t":/,(?=(?:[^"]*"[^"]*")*[^"]*$)/);
            let clean = v => (v||"").trim().replace(/^"|"$/g,"");
            return { front:clean(parts[0]), reading:clean(parts[1]), back:clean(parts[2]), color:clean(parts[3])||"white", known:clean(parts[4])||"", tags:(clean(parts[5])||"").split("|").filter(Boolean) };
          });
          decks.push({ name: f.name.replace(/\.[^.]+$/,""), cards:newCards, gridCols:6, gridRows:Math.ceil(newCards.length/6) });
          saveKanjiDecksRaw(decks); loadKanjiDeck(decks.length-1); alert("✓ Import CSV thành công!");
        }
      } catch(err) { alert("Lỗi: "+err.message); }
    };
    reader.readAsText(f);
  };
  inp.click(); document.getElementById("importModal").classList.remove("active");
}

