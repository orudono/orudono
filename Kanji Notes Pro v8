   INLINE NOTES
============================================================ */
function openNoteModal() {
  let sel = window.getSelection();
  if (!sel || sel.isCollapsed) return;
  pendingNoteRange = sel.getRangeAt(0).cloneRange();
  pendingNoteColor = 'yellow';
  document.getElementById('noteText').value = '';
  document.querySelectorAll('.note-color-opt').forEach((o,i) => {
    o.classList.toggle('selected', NOTE_COLORS[i] === 'yellow');
  });
  document.getElementById('noteModal').classList.add('active');
  setTimeout(() => document.getElementById('noteText').focus(), 50);
  hideSelectionPopup();
}

function closeNoteModal() {
  document.getElementById('noteModal').classList.remove('active');
  pendingNoteRange = null;
}

function saveNote() {
  let text = document.getElementById('noteText').value.trim();
  if (!text || !pendingNoteRange) { closeNoteModal(); return; }
  takeEditorSnapshot();
  let span = document.createElement('span');
  span.className = 'inline-note';
  span.setAttribute('data-note', text);
  span.setAttribute('data-color', pendingNoteColor);
  span.setAttribute('contenteditable', 'false');
  try {
    pendingNoteRange.surroundContents(span);
  } catch(e) {
    let frag = pendingNoteRange.extractContents();
    span.appendChild(frag);
    pendingNoteRange.insertNode(span);
  }
  bindNoteContextMenu(span);
  scheduleEditorSnapshot();
  saveNotesDeck();
  closeNoteModal();
}

function bindNoteContextMenu(span) {
  span.addEventListener('contextmenu', e => {
    e.preventDefault(); e.stopPropagation();
    showNoteContextMenu(span, e.clientX, e.clientY);
  });
}

let noteCtxMenu = null;
function showNoteContextMenu(span, x, y) {
  if (noteCtxMenu) noteCtxMenu.remove();
  noteCtxMenu = document.createElement('div');
  noteCtxMenu.style.cssText = `position:fixed;left:${x}px;top:${y}px;background:#1e1e2e;color:white;
    border-radius:8px;padding:4px;z-index:9999;box-shadow:0 4px 20px rgba(0,0,0,.4);
    min-width:160px;font-size:12px;border:1px solid #3a3a5a;`;
  const mkItem = (label, fn) => {
    let item = document.createElement('div');
    item.style.cssText = 'padding:6px 12px;cursor:pointer;border-radius:5px;';
    item.textContent = label;
    item.onmouseenter = () => item.style.background = 'rgba(255,255,255,.1)';
    item.onmouseleave = () => item.style.background = '';
    item.onclick = () => { noteCtxMenu?.remove(); noteCtxMenu = null; fn(); };
    return item;
  };
  noteCtxMenu.appendChild(mkItem('✏️ Sửa ghi chú', () => editNote(span)));
  NOTE_COLORS.forEach(col => {
    noteCtxMenu.appendChild(mkItem(`● Đổi sang màu ${col}`, () => {
      span.setAttribute('data-color', col); saveNotesDeck();
    }));
  });
  noteCtxMenu.appendChild(mkItem('🗑 Xóa ghi chú', () => deleteNote(span)));
  document.body.appendChild(noteCtxMenu);
  setTimeout(() => document.addEventListener('click', removNoteCtx, {once:true}), 10);
}

function removNoteCtx() { noteCtxMenu?.remove(); noteCtxMenu = null; }

function editNote(span) {
  let text = prompt('Sửa ghi chú:', span.getAttribute('data-note'));
  if (text !== null) {
    takeEditorSnapshot();
    span.setAttribute('data-note', text);
    scheduleEditorSnapshot();
    saveNotesDeck();
  }
}

function deleteNote(span) {
  takeEditorSnapshot();
  let parent = span.parentNode;
  while (span.firstChild) parent.insertBefore(span.firstChild, span);
  parent.removeChild(span);
  scheduleEditorSnapshot();
  saveNotesDeck();
}

function rebindNotes() {
  document.querySelectorAll('#editor .inline-note').forEach(bindNoteContextMenu);
}

/* ============================================================
   TOC
============================================================ */
let tocIdCounter = 0;
function nextTocId() { return 'toc-' + (++tocIdCounter); }

function addTocFromSelection(level) {
  let sel = window.getSelection();
  if (!sel || sel.isCollapsed) return;
  let text = sel.toString().trim();
  if (!text) return;
  let range = sel.getRangeAt(0);
  takeEditorSnapshot();
  let id = nextTocId();
  let span = document.createElement('span');
  span.setAttribute('data-toc-id', id);
  span.setAttribute('data-toc-level', level);
  span.setAttribute('data-toc-text', text);
  span.style.fontWeight = level === 'H1' ? 'bold' : level === 'H2' ? '600' : 'normal';
  span.style.borderBottom = `2px solid var(--accent)`;
  span.style.paddingBottom = '1px';
  try {
    range.surroundContents(span);
  } catch(e) {
    let frag = range.extractContents();
    span.appendChild(frag);
    range.insertNode(span);
  }
  scheduleEditorSnapshot();
  updateTOC();
  hideSelectionPopup();
}

function updateTOC() {
  let tocList = document.getElementById('tocList');
  let editor = document.getElementById('editor');
  let items = editor.querySelectorAll('[data-toc-id]');
  tocList.innerHTML = '';
  if (items.length === 0) {
    let empty = document.createElement('div');
    empty.style.cssText = 'padding:12px 10px;font-size:11px;color:var(--text-muted);font-style:italic;';
    empty.textContent = 'Bôi đen text → chọn H1/H2/H3 để thêm vào mục lục';
    tocList.appendChild(empty); return;
  }
  items.forEach((el) => {
    let level = el.getAttribute('data-toc-level') || 'H2';
    let text = el.textContent.trim() || el.getAttribute('data-toc-text') || '(tiêu đề)';
    let item = document.createElement('div');
    item.className = 'toc-item toc-' + level.toLowerCase();
    let label = document.createElement('span');
    label.className = 'toc-label'; label.textContent = (level==='H1'?'':'  ') + text;
    label.onclick = () => { el.scrollIntoView({ behavior: 'smooth', block: 'center' }); };
    let actions = document.createElement('div'); actions.className = 'toc-actions';
    let editBtn = document.createElement('button'); editBtn.className = 'toc-act-btn'; editBtn.textContent = '✏️';
    editBtn.title = 'Sửa tiêu đề'; editBtn.onclick = () => openTocEditModal(el);
    let delBtn = document.createElement('button'); delBtn.className = 'toc-act-btn'; delBtn.textContent = '🗑';
    delBtn.title = 'Xóa'; delBtn.onclick = () => removeTocItem(el);
    actions.appendChild(editBtn); actions.appendChild(delBtn);
    item.appendChild(label); item.appendChild(actions);
    tocList.appendChild(item);
  });
}

function removeTocItem(el) {
  takeEditorSnapshot();
  let parent = el.parentNode;
  while (el.firstChild) parent.insertBefore(el.firstChild, el);
  parent.removeChild(el);
  scheduleEditorSnapshot(); updateTOC(); saveNotesDeck();
}

function openTocEditModal(el) {
  tocEditTarget = el;
  document.getElementById('tocEditInput').value = el.textContent.trim();
  document.getElementById('tocEditLevel').value = el.getAttribute('data-toc-level') || 'H2';
  document.getElementById('tocEditModal').classList.add('active');
  setTimeout(() => document.getElementById('tocEditInput').focus(), 50);
}

function closeTocEditModal() {
  document.getElementById('tocEditModal').classList.remove('active');
  tocEditTarget = null;
}

function saveTocEdit() {
  if (!tocEditTarget) return;
  let newText = document.getElementById('tocEditInput').value.trim();
  let newLevel = document.getElementById('tocEditLevel').value;
  if (!newText) { closeTocEditModal(); return; }
  takeEditorSnapshot();
  tocEditTarget.setAttribute('data-toc-level', newLevel);
  tocEditTarget.setAttribute('data-toc-text', newText);
  tocEditTarget.style.fontWeight = newLevel === 'H1' ? 'bold' : newLevel === 'H2' ? '600' : 'normal';
  scheduleEditorSnapshot(); updateTOC(); saveNotesDeck(); closeTocEditModal();
}

function toggleTOC() {
  tocVisible = !tocVisible;
  let panel = document.getElementById('tocPanel');
  let resizer = document.getElementById('tocResizer');
  panel.classList.toggle('hidden', !tocVisible);
  resizer.style.display = tocVisible ? '' : 'none';
}

/* ============================================================
   CARDS
============================================================ */
function escHtml(s) { return String(s||"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }

function createCardElement(d, idx) {
  let card = document.createElement("div");
  card.className = "card" + (d.known==="1"?" known":d.known==="0"?" unknown":"") + ((!d.front||d.front==="□")?" empty-card":"");
  card.dataset.front = d.front || "□"; card.dataset.back = d.back || "";
  card.dataset.reading = d.reading || ""; card.dataset.known = d.known || "";
  card.dataset.tags = JSON.stringify(d.tags || []); card.dataset.idx = idx;
  card.style.background = d.color || "white"; card.style.fontFamily = cardFontFamily;

  let statusEl = document.createElement("span"); statusEl.className = "card-status";
  if (d.known==="1") statusEl.textContent = "✓";
  else if (d.known==="0") statusEl.textContent = "✗";

  let textEl = document.createElement("span"); textEl.className = "card-text";
  textEl.textContent = d.front || "□";

  let tagsEl = document.createElement("div"); tagsEl.className = "card-tags";
  (d.tags||[]).forEach((t,ti) => {
    let chip = document.createElement("span"); chip.className = "card-tag";
    chip.style.background = TAG_COLORS[ti % TAG_COLORS.length];
    chip.textContent = t; tagsEl.appendChild(chip);
  });

  let quickEl = document.createElement("div"); quickEl.className = "card-quick";
  let btnK = document.createElement("button"); btnK.textContent = "✓"; btnK.title = "Known";
  btnK.onclick = e => { e.stopPropagation(); quickMark(card, true); };
  let btnU = document.createElement("button"); btnU.textContent = "✗"; btnU.title = "Unknown";
  btnU.onclick = e => { e.stopPropagation(); quickMark(card, false); };
  quickEl.appendChild(btnU); quickEl.appendChild(btnK);
  card.appendChild(statusEl); card.appendChild(textEl); card.appendChild(tagsEl); card.appendChild(quickEl);
  card.addEventListener("click", e => { if (e.shiftKey) { toggleSelectCard(card); return; } flip(card); });
  card.addEventListener("dblclick", e => { e.stopPropagation(); openEditModal(card); });
  card.addEventListener("contextmenu", e => {
    e.preventDefault(); snapshotDeck(); card.style.background = selectedColor; saveKanjiDeck();
  });
  return card;
}

function quickMark(card, known) { snapshotDeck(); setCardKnown(card, known); startTimer(); }

let cards = [];

function rebuildGrid() {
  let total = gridCols * gridRows;
  let grid = document.getElementById("flashGrid");
  let existing = cards.map(c => ({
    front: c.dataset.front, back: c.dataset.back, reading: c.dataset.reading || "",
    color: c.style.background, known: c.dataset.known, tags: JSON.parse(c.dataset.tags || "[]")
  }));
  grid.innerHTML = ""; cards = [];
  grid.style.gridTemplateColumns = "repeat("+gridCols+",1fr)";
  grid.style.gridTemplateRows = "repeat("+gridRows+",1fr)";
  let deckData = getKanjiDecks()[currentKanjiDeck]?.cards || [];
  for (let i = 0; i < total; i++) {
    let d = deckData[i] || existing[i] || { front:"□", back:"", reading:"", color:"white", known:"", tags:[] };
    let card = createCardElement(d, i);
    grid.appendChild(card); cards.push(card);
  }
  saveKanjiDeck(); updateProgress(); applyFilter();
}

function flip(card) {
  if (card.classList.contains("back")) {
    card.classList.remove("back"); card.querySelector(".card-text").textContent = card.dataset.front;
  } else {
    card.classList.add("back");
    let reading = card.dataset.reading ? "[" + card.dataset.reading + "] " : "";
    card.querySelector(".card-text").textContent = reading + (card.dataset.back || "(chưa có nghĩa)");
  }
}

function revealAll() {
  allCardsRevealed = !allCardsRevealed;
  cards.forEach(c => {
    if (allCardsRevealed) {
      c.classList.add("back");
      let reading = c.dataset.reading ? "[" + c.dataset.reading + "] " : "";
      c.querySelector(".card-text").textContent = reading + (c.dataset.back || "(chưa có nghĩa)");
    } else {
      c.classList.remove("back"); c.querySelector(".card-text").textContent = c.dataset.front;
    }
  });
  document.getElementById("revealAllBtn").textContent = allCardsRevealed ? "👁 Hide All" : "👁 Reveal All";
}

function setCardKnown(card, known) {
  card.dataset.known = known ? "1" : "0";
  card.classList.remove("known","unknown"); card.classList.add(known ? "known" : "unknown");
  card.querySelector(".card-status").textContent = known ? "✓" : "✗";
  saveKanjiDeck(); updateProgress(); recordStudyActivity();
}

function updateProgress() {
  let total = cards.filter(c => c.dataset.front !== "□").length;
  let known = cards.filter(c => c.dataset.known === "1").length;
  let pct = total > 0 ? Math.round(known / total * 100) : 0;
  document.getElementById("progressText").textContent = known + " / " + total + " thuộc (" + pct + "%)";
  document.getElementById("progressFill").style.width = pct + "%";
  renderSidebar();
}

function resetProgress() {
  if (!confirm("Reset tiến độ deck này?")) return;
  snapshotDeck();
  cards.forEach(c => { c.dataset.known = ""; c.classList.remove("known","unknown"); c.querySelector(".card-status").textContent = ""; });
  saveKanjiDeck(); updateProgress();
}

/* ============================================================
   FILTER & SORT
============================================================ */
function setFilter(f, btn) {
  currentFilter = f;
  document.querySelectorAll(".filter-btn").forEach(b => b.classList.remove("active"));
  if (btn) btn.classList.add("active");
  applyFilter();
}

function applyFilter() {
  cards.forEach(card => {
    let show = true;
    if (currentFilter === 'known') show = card.dataset.known === "1";
    else if (currentFilter === 'unknown') show = card.dataset.known === "0";
    else if (currentFilter === 'none') show = card.dataset.known === "";
    card.style.display = show ? "" : "none";
  });
  updateListView();
}

function sortByNumber() {
  let decks = getKanjiDecks(), deck = decks[currentKanjiDeck]; if (!deck) return;
  snapshotDeck();
  deck.cards = (deck.cards || []).slice().sort((a,b) => { let na=parseInt(a.front)||Infinity, nb=parseInt(b.front)||Infinity; return na-nb; });
  saveKanjiDecksRaw(decks); loadKanjiDeck(currentKanjiDeck);
}

function sortAlpha() {
  let decks = getKanjiDecks(), deck = decks[currentKanjiDeck]; if (!deck) return;
  snapshotDeck();
  deck.cards = (deck.cards || []).slice().sort((a,b) => (a.front||"").localeCompare(b.front||"", "ja"));
  saveKanjiDecksRaw(decks); loadKanjiDeck(currentKanjiDeck);
}

/* ============================================================
   LIST VIEW
============================================================ */
function toggleView() {
  currentViewMode = currentViewMode === 'grid' ? 'list' : 'grid';
  document.getElementById("flashGrid").style.display = currentViewMode === 'grid' ? 'grid' : 'none';
  document.getElementById("listView").classList.toggle("active", currentViewMode === 'list');
  document.getElementById("viewToggleBtn").textContent = currentViewMode === 'grid' ? '📋 List' : '⊞ Grid';
  updateListView();
}

function updateListView() {
  let tbody = document.getElementById("listBody"); tbody.innerHTML = "";
  cards.forEach((card, i) => {
    if (currentFilter === 'known' && card.dataset.known !== "1") return;
    if (currentFilter === 'unknown' && card.dataset.known !== "0") return;
    if (currentFilter === 'none' && card.dataset.known !== "") return;
    let tr = document.createElement("tr");
    let statusClass = card.dataset.known==="1"?"ls-known":card.dataset.known==="0"?"ls-unknown":"ls-none";
    let statusText = card.dataset.known==="1"?"✓ Thuộc":card.dataset.known==="0"?"✗ Chưa":"Chưa học";
    let tags = JSON.parse(card.dataset.tags||"[]");
    tr.innerHTML = `<td>${i+1}</td>
      <td style="font-size:18px;font-family:${cardFontFamily}">${escHtml(card.dataset.front)}</td>
      <td>${escHtml(card.dataset.reading)}</td>
      <td>${escHtml(card.dataset.back)}</td>
      <td>${tags.map((t,ti)=>`<span style="background:${TAG_COLORS[ti%TAG_COLORS.length]};color:white;border-radius:3px;padding:1px 5px;font-size:10px;">${escHtml(t)}</span>`).join(' ')}</td>
      <td><span class="list-status ${statusClass}">${statusText}</span></td>
      <td><button style="border:none;background:none;cursor:pointer;font-size:13px;" onclick="openEditModalByIdx(${i})">✏️</button></td>`;
    tbody.appendChild(tr);
  });
}

