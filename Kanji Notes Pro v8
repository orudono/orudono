function format(cmd) {
  takeEditorSnapshot();
  document.getElementById("editor").focus();
  document.execCommand(cmd, false, null);
  scheduleEditorSnapshot();
}

function changeFont(f) { takeEditorSnapshot(); document.execCommand("fontName", false, f); scheduleEditorSnapshot(); }

function applyHeading(tag) {
  takeEditorSnapshot(); document.execCommand("formatBlock", false, tag); scheduleEditorSnapshot();
  setTimeout(updateTOC, 100);
}

function applyFontSize(px) {
  let editor = document.getElementById("editor"); editor.focus(); takeEditorSnapshot();
  let sel = window.getSelection();
  if (!sel || sel.rangeCount===0 || sel.isCollapsed) { editor.style.fontSize = px+"pt"; return; }
  let range = sel.getRangeAt(0), span = document.createElement("span");
  span.style.fontSize = px+"pt";
  try { range.surroundContents(span); } catch(e) { let frag=range.extractContents(); span.appendChild(frag); range.insertNode(span); }
  scheduleEditorSnapshot();
}

function applyLineHeight(v) { takeEditorSnapshot(); document.getElementById("editor").style.lineHeight = v; scheduleEditorSnapshot(); }

function applyHighlight() {
  let editor = document.getElementById("editor"); editor.focus(); takeEditorSnapshot();
  document.execCommand("backColor", false, currentHighlight === 'transparent' ? 'transparent' : currentHighlight);
  scheduleEditorSnapshot();
}

function applyTextColor() {
  let editor = document.getElementById("editor"); editor.focus(); takeEditorSnapshot();
  document.execCommand("foreColor", false, currentTextColor);
  scheduleEditorSnapshot();
}

function insertTable() {
  let cols = parseInt(prompt("Số cột:", "3")); if (!cols || cols<1) return;
  let rows = parseInt(prompt("Số hàng:", "3")); if (!rows || rows<1) return;
  takeEditorSnapshot();
  let html = '<table style="border-collapse:collapse;width:100%;margin:8px 0;">';
  for (let r=0; r<rows; r++) {
    html += "<tr>";
    for (let c=0; c<cols; c++) html += '<td style="border:1px solid #ccc;padding:6px 10px;min-width:60px;">&nbsp;</td>';
    html += "</tr>";
  }
  html += "</table><p><br></p>";
  document.getElementById("editor").focus();
  document.execCommand("insertHTML", false, html);
  scheduleEditorSnapshot();
}

function insertImage() {
  let inp = document.createElement("input"); inp.type="file"; inp.accept="image/*";
  inp.onchange = () => {
    let file = inp.files[0]; if (!file) return;
    let reader = new FileReader();
    reader.onload = e => {
      takeEditorSnapshot();
      document.getElementById("editor").focus();
      document.execCommand("insertHTML", false, '<img src="'+e.target.result+'" style="max-width:100%;border-radius:4px;">');
      scheduleEditorSnapshot();
    };
    reader.readAsDataURL(file);
  };
  inp.click();
}

function toggleFindBar() {
  let bar = document.getElementById("findBar"); bar.classList.toggle("active");
  if (bar.classList.contains("active")) document.getElementById("findInput").focus();
}

function findNext() { let term = document.getElementById("findInput").value; if (!term) return; window.find(term, false, false, true); }

function replaceOne() {
  let find = document.getElementById("findInput").value, rep = document.getElementById("replaceInput").value;
  if (!find) return;
  let sel = window.getSelection();
  if (sel && sel.toString().toLowerCase() === find.toLowerCase()) { takeEditorSnapshot(); document.execCommand("insertText", false, rep); scheduleEditorSnapshot(); }
  findNext();
}

function replaceAll() {
  let find = document.getElementById("findInput").value, rep = document.getElementById("replaceInput").value;
  if (!find) return; takeEditorSnapshot();
  let editor = document.getElementById("editor");
  editor.innerHTML = editor.innerHTML.split(find).join(rep);
  scheduleEditorSnapshot(); saveNotesDeck();
}

function updateWordCount() {
  let text = document.getElementById("editor").innerText || "";
