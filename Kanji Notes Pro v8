   BULK IMPORT
============================================================ */
function openBulkImport() { document.getElementById("bulkModal").classList.add("active"); }
function closeBulkModal() { document.getElementById("bulkModal").classList.remove("active"); }

function saveBulkImport() {
  snapshotDeck();
  let text = document.getElementById("bulkText").value.trim();
  let startIdx = Math.max(0, parseInt(document.getElementById("bulkStart").value||1) - 1);
  let lines = text.split("\n").map(l=>l.trim()).filter(Boolean);
  lines.forEach((line, i) => {
    let idx = startIdx + i; if (idx >= cards.length) return;
    let parts = line.split(/,(?=(?:[^"]*"[^"]*")*[^"]*$)/);
    let front = (parts[0]||"").trim().replace(/^"|"$/g,"");
    let reading = parts.length >= 3 ? (parts[1]||"").trim().replace(/^"|"$/g,"") : "";
    let back = parts.length >= 3 ? (parts[2]||"").trim().replace(/^"|"$/g,"") : (parts[1]||"").trim().replace(/^"|"$/g,"");
    let card = cards[idx];
    card.dataset.front = front || "□"; card.dataset.back = back; card.dataset.reading = reading;
    card.classList.remove("back","empty-card");
    if (!front) card.classList.add("empty-card");
    card.querySelector(".card-text").textContent = front || "□";
  });
  saveKanjiDeck(); updateProgress(); updateListView(); closeBulkModal();
}

