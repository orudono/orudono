function startTimer() {
  if (timerRunning) return; timerRunning = true;
  timerInterval = setInterval(() => {
    timerSeconds++;
    let m = String(Math.floor(timerSeconds/60)).padStart(2,"0");
    let s = String(timerSeconds%60).padStart(2,"0");
    document.getElementById("timerDisplay").textContent = "⏱ " + m + ":" + s;
  }, 1000);
}

function toggleTimer() {
  if (timerRunning) { clearInterval(timerInterval); timerRunning = false; document.getElementById("timerDisplay").textContent = document.getElementById("timerDisplay").textContent.replace("⏱","⏸"); }
  else startTimer();
}

function resetTimer() { clearInterval(timerInterval); timerRunning = false; timerSeconds = 0; document.getElementById("timerDisplay").textContent = "⏱ 00:00"; }

/* ============================================================
   SHUFFLE
============================================================ */
function shuffleCards() {
  snapshotDeck();
  let data = cards.map(c => ({
    front: c.dataset.front, back: c.dataset.back, reading: c.dataset.reading||"",
    color: c.style.background, known: c.dataset.known, tags: JSON.parse(c.dataset.tags||"[]")
  }));
  for (let i = data.length-1; i > 0; i--) { let j = Math.floor(Math.random()*(i+1)); [data[i],data[j]] = [data[j],data[i]]; }
  data.forEach((d,i) => {
    let c = cards[i];
    c.dataset.front=d.front; c.dataset.back=d.back; c.dataset.reading=d.reading;
    c.style.background=d.color; c.dataset.known=d.known; c.dataset.tags=JSON.stringify(d.tags);
    c.classList.remove("back","known","unknown","empty-card");
    c.querySelector(".card-text").textContent = d.front;
    let ks = c.querySelector(".card-status");
    if (d.known==="1"){c.classList.add("known");ks.textContent="✓";}
    else if (d.known==="0"){c.classList.add("unknown");ks.textContent="✗";}
    else ks.textContent="";
    if (d.front==="□") c.classList.add("empty-card");
  });
  saveKanjiDeck();
}

/* ============================================================
   STUDY MODE
============================================================ */
function openStudy() {
  let active = cards.filter(c => c.dataset.front && c.dataset.front !== "□");
  if (active.length === 0) { alert("Deck trống!"); return; }
  studyQueue = active.map(c => ({ front: c.dataset.front, back: c.dataset.back, reading: c.dataset.reading||"", cardRef: c })).sort(() => Math.random() - .5);
  studyIndex = 0; studyKnown = 0; studyUnknown = 0;
  let decks = getKanjiDecks();
  document.getElementById("studyDeckName").textContent = decks[currentKanjiDeck]?.name || ("Deck "+(currentKanjiDeck+1));
  document.getElementById("studyResult").style.display = "none";
  document.getElementById("studyCard").style.display = "flex";
  document.getElementById("studyControls").style.display = "none";
  document.getElementById("studyOverlay").classList.add("active");
  showStudyCard();
}

function showStudyCard() {
  if (studyIndex >= studyQueue.length) { endStudy(); return; }
  let item = studyQueue[studyIndex]; studyRevealed = false;
  document.getElementById("studyFront").textContent = item.front;
  document.getElementById("studyFront").style.fontFamily = cardFontFamily;
  document.getElementById("studyReading").style.display = "none";
  document.getElementById("studyBack").style.display = "none";
  document.getElementById("studyBack").textContent = item.back || "(chưa có nghĩa)";
  document.getElementById("studyReading").textContent = item.reading;
  document.getElementById("studyHint").style.display = "block";
  document.getElementById("studyShortcuts").style.display = "block";
  document.getElementById("studyControls").style.display = "none";
  document.getElementById("studyCard").style.background = item.cardRef?.style.background || "white";
  updateStudyHeader(); clearInterval(studyCardTimer); studyCardSeconds = 0;
  studyCardTimer = setInterval(() => {
    studyCardSeconds++;
    let m=String(Math.floor(studyCardSeconds/60)).padStart(2,"0"), s=String(studyCardSeconds%60).padStart(2,"0");
    document.getElementById("studyTimer").textContent = m+":"+s;
  }, 1000);
}

function revealCard() {
  if (studyRevealed) return; studyRevealed = true; clearInterval(studyCardTimer);
  if (studyQueue[studyIndex]?.reading) document.getElementById("studyReading").style.display = "block";
  document.getElementById("studyBack").style.display = "block";
  document.getElementById("studyHint").style.display = "none";
  document.getElementById("studyShortcuts").style.display = "none";
  document.getElementById("studyControls").style.display = "flex";
}

function markCard(known) {
  let item = studyQueue[studyIndex];
  if (item?.cardRef) setCardKnown(item.cardRef, known);
  if (known) studyKnown++; else studyUnknown++;
  studyIndex++; showStudyCard();
}

function nextStudyCard() { studyIndex++; showStudyCard(); }

function updateStudyHeader() {
  document.getElementById("studyProgress").textContent = "Thẻ "+(studyIndex+1)+" / "+studyQueue.length;
  document.getElementById("studyScore").textContent = "✓ "+studyKnown+"  ✗ "+studyUnknown;
}

function endStudy() {
  clearInterval(studyCardTimer);
  document.getElementById("studyCard").style.display = "none";
  document.getElementById("studyControls").style.display = "none";
  document.getElementById("studyResult").style.display = "block";
  let total = studyQueue.length, pct = total > 0 ? Math.round(studyKnown/total*100) : 0;
  document.getElementById("resultText").textContent = "Đã thuộc: "+studyKnown+"/"+total+" ("+pct+"%)\nChưa thuộc: "+studyUnknown;
}

function restartStudy() {
  document.getElementById("studyResult").style.display = "none";
  document.getElementById("studyCard").style.display = "flex";
  studyQueue = studyQueue.sort(() => Math.random() - .5);
  studyIndex = 0; studyKnown = 0; studyUnknown = 0; showStudyCard();
}

function closeStudy() { clearInterval(studyCardTimer); document.getElementById("studyOverlay").classList.remove("active"); }

/* ============================================================
   KEYBOARD SHORTCUTS
============================================================ */
document.addEventListener("keydown", e => {
  if (document.getElementById("studyOverlay").classList.contains("active")) {
    if (e.key===" "||e.key==="Enter") { e.preventDefault(); revealCard(); }
    if ((e.key==="ArrowRight"||e.key==="k") && studyRevealed) markCard(true);
    if ((e.key==="ArrowLeft"||e.key==="u") && studyRevealed) markCard(false);
    if (e.key==="Escape") closeStudy();
    return;
  }
  let isEditorFocused = document.activeElement === document.getElementById("editor");
  let isInputFocused = ["INPUT","TEXTAREA","SELECT"].includes(document.activeElement.tagName);
  if ((e.ctrlKey || e.metaKey) && !e.shiftKey && e.key.toLowerCase() === "z") {
    if (currentSheet === 2 && isEditorFocused) { e.preventDefault(); editorUndo(); }
    else if (currentSheet === 1 && !isInputFocused) { e.preventDefault(); deckUndo(); }
  }
  if ((e.ctrlKey || e.metaKey) && (e.key.toLowerCase() === "y" || (e.shiftKey && e.key.toLowerCase() === "z"))) {
    if (currentSheet === 2 && isEditorFocused) { e.preventDefault(); editorRedo(); }
    else if (currentSheet === 1 && !isInputFocused) { e.preventDefault(); deckRedo(); }
  }
  if (e.key === "Escape") {
    closeAllColorPickers(); hideSelectionPopup();
    if (noteCtxMenu) { noteCtxMenu.remove(); noteCtxMenu = null; }
    if (document.getElementById('renameModal').classList.contains('active')) closeRenameModal();
  }
});

/* ============================================================
   KANJI DECK STORAGE
============================================================ */
function saveKanjiDeck(skipSnapshot) {
  let decks = getKanjiDecks();
  if (!decks[currentKanjiDeck]) decks[currentKanjiDeck] = { name: "Deck 1" };
  decks[currentKanjiDeck].cards = cards.map(c => ({
    front: c.dataset.front, back: c.dataset.back, reading: c.dataset.reading||"",
    color: c.style.background, known: c.dataset.known, tags: JSON.parse(c.dataset.tags||"[]")
  }));
  decks[currentKanjiDeck].gridCols = gridCols;
  decks[currentKanjiDeck].gridRows = gridRows;
  decks[currentKanjiDeck].fontFamily = cardFontFamily;
  saveKanjiDecksRaw(decks);
}

function loadKanjiDeck(i) {
  currentKanjiDeck = i;
  deckUndoHistory[i] = { stack: [], pointer: -1 };
  resetTimer();
  let decks = getKanjiDecks(), deck = decks[i] || { cards:[], gridCols:6, gridRows:5 };
  if (deck.gridCols && deck.gridRows) { gridCols = deck.gridCols; gridRows = deck.gridRows; document.getElementById("gridSizeBtn").textContent = gridCols+" × "+gridRows+" ▾"; }
  if (deck.fontFamily) { cardFontFamily = deck.fontFamily; document.getElementById("cardFontSelect").value = deck.fontFamily; }
  let total = gridCols * gridRows, grid = document.getElementById("flashGrid");
  grid.innerHTML = ""; cards = [];
  grid.style.gridTemplateColumns = "repeat("+gridCols+",1fr)";
  grid.style.gridTemplateRows = "repeat("+gridRows+",1fr)";
  let deckArr = deck.cards || [];
  for (let idx = 0; idx < total; idx++) {
    let d = deckArr[idx] || { front:"□", back:"", reading:"", color:"white", known:"", tags:[] };
    let card = createCardElement(d, idx);
    grid.appendChild(card); cards.push(card);
  }
  updateProgress(); applyFilter(); renderSidebar();
  snapshotDeck(); updateDeckUndoButtons();
}

function addKanjiDeck() {
  let decks = getKanjiDecks();
  let empty = Array(gridCols*gridRows).fill(null).map(()=>({front:"□",back:"",reading:"",color:"white",known:"",tags:[]}));
  decks.push({ name:"Deck "+(decks.length+1), cards:empty, gridCols, gridRows });
  saveKanjiDecksRaw(decks); loadKanjiDeck(decks.length-1);
}

function deleteSelectedKanji() {
  if (selectedKanjiDecks.size === 0) { alert("Chọn ít nhất 1 deck!"); return; }
  if (!confirm("Xóa "+selectedKanjiDecks.size+" deck?")) return;
  let decks = getKanjiDecks().filter((_,i) => !selectedKanjiDecks.has(i));
  if (decks.length === 0) decks.push({ name:"Deck 1", cards:[], gridCols:6, gridRows:5 });
  saveKanjiDecksRaw(decks); selectedKanjiDecks.clear(); loadKanjiDeck(0);
}

function renameKanjiDeck(i) {
  let decks = getKanjiDecks();
  let current = decks[i]?.name || ("Deck "+(i+1));
  openRenameModal('✏️ Đổi tên Deck', current, newName => {
    let d = getKanjiDecks();
    if (d[i]) { d[i].name = newName; saveKanjiDecksRaw(d); renderSidebar(); }
  });
}

function getDeckProgress(deck) {
  let arr = deck.cards || [];
  return { known: arr.filter(c => c && c.known==="1").length, total: arr.filter(c => c && c.front!=="□").length };
}

