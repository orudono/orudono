  document.getElementById("statsPanel").classList.add("active");
  let kd = getKanjiDecks(), totalCards=0, totalKnown=0;
  kd.forEach(d => { let arr=d.cards||[]; totalCards+=arr.filter(c=>c&&c.front!=="□").length; totalKnown+=arr.filter(c=>c&&c.known==="1").length; });
  let pct = totalCards>0?Math.round(totalKnown/totalCards*100):0;
  document.getElementById("statsGrid").innerHTML = `
    <div class="stat-card"><div class="stat-num">${kd.length}</div><div class="stat-label">Decks</div></div>
    <div class="stat-card"><div class="stat-num">${totalCards}</div><div class="stat-label">Tổng thẻ</div></div>
    <div class="stat-card"><div class="stat-num">${pct}%</div><div class="stat-label">Đã thuộc</div></div>
  `;
  let hist = JSON.parse(localStorage.getItem("studyHistory_v5")||"{}");
  let streakRow = document.getElementById("streakRow"); streakRow.innerHTML = "";
  let now = new Date();
  for (let i=69; i>=0; i--) {
    let d = new Date(now); d.setDate(d.getDate()-i);
    let key = d.toISOString().slice(0,10), count = hist[key]||0;
    let cell = document.createElement("div"); cell.className = "streak-cell";
    if (count>=20) cell.classList.add("s4"); else if (count>=10) cell.classList.add("s3"); else if (count>=3) cell.classList.add("s2"); else if (count>=1) cell.classList.add("s1");
    cell.title = key+": "+count+" thẻ"; streakRow.appendChild(cell);
  }
}

/* ============================================================
   GLOBAL CLICK — close panels
============================================================ */
document.addEventListener("click", e => {
  if (!document.getElementById("gridSizePicker").contains(e.target) && e.target.id !== "gridSizeBtn")
    document.getElementById("gridSizePicker").style.display = "none";
  if (!document.getElementById("themePanel").contains(e.target) && !e.target.closest('#topbar button')?.textContent.includes("Theme"))
    document.getElementById("themePanel").classList.remove("active");
  if (!document.getElementById("statsPanel").contains(e.target) && e.target.textContent !== "📊")
    document.getElementById("statsPanel").classList.remove("active");
  document.querySelectorAll('.color-picker-popup.open').forEach(p => {
    let group = p.closest('.color-tool-group');
    if (group && !group.contains(e.target)) p.classList.remove('open');
  });
});

/* ============================================================
   SHEET SWITCH
============================================================ */
function switchSheet(n) {
  if (n === 2) saveNotesDeck();
  currentSheet = n;
  document.querySelectorAll(".sheet").forEach(s => s.classList.remove("active"));
  document.getElementById("sheet"+n).classList.add("active");
  if (n === 2) { updateTOC(); rebindNotes(); }
  renderSidebar();
}

/* ============================================================
   INIT
============================================================ */
(function init() {
  buildGridPicker();
  buildSwatches();
  buildThemePresets();
  loadTheme(); syncThemePickers();

  let kd = getKanjiDecks();
  if (kd.length === 0) {
    let empty = Array(30).fill(null).map(()=>({front:"□",back:"",reading:"",color:"white",known:"",tags:[]}));
    saveKanjiDecksRaw([{ name:"Deck 1", cards:empty, gridCols:6, gridRows:5 }]);
  } else {
    let migrated = false;
    kd.forEach((d,i) => {
      if (Array.isArray(d)) {
        let name = d.name || ("Deck "+(i+1)), gCols = d.gridCols||6, gRows = d.gridRows||5;
        let cardsArr = d.filter((_,j)=>typeof j==="number").map(c=>({
          front:c?.front||"□",back:c?.back||"",reading:c?.reading||"",
          color:c?.color||"white",known:c?.known||"",tags:c?.tags||[]
        }));
        kd[i] = { name, cards:cardsArr, gridCols:gCols, gridRows:gRows }; migrated = true;
      }
    });
    if (migrated) saveKanjiDecksRaw(kd);
  }
  loadKanjiDeck(0);

  let nd = getNotesDecks();
  if (nd.length === 0) { nd.push({content:"",name:"Note 1"}); saveNotesDecksRaw(nd); }
  document.getElementById("editor").innerHTML = nd[0].content || "";
  editorLastSnapshot = document.getElementById("editor").innerHTML;
  updateWordCount(); updateTOC(); updateEditorUndoButtons();
  rebindNotes();
  renderSidebar();

  setInterval(()=>{ if(currentSheet===2) saveNotesDeck(); }, 30000);
})();
</script>

