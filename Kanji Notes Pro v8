/* ============================================================
   SIDEBAR DRAG & DROP
============================================================ */
let dragSrcType = null, dragSrcIdx = -1;

function makeDraggableDeck(row, type, i) {
  row.draggable = true;
  row.addEventListener("dragstart", e => { dragSrcType = type; dragSrcIdx = i; e.dataTransfer.effectAllowed = "move"; row.style.opacity = "0.5"; });
  row.addEventListener("dragend", () => row.style.opacity = "");
  row.addEventListener("dragover", e => { e.preventDefault(); row.classList.add("drag-over"); });
  row.addEventListener("dragleave", () => row.classList.remove("drag-over"));
  row.addEventListener("drop", e => {
    e.preventDefault(); row.classList.remove("drag-over");
    let targetIdx = i; if (dragSrcType !== type || dragSrcIdx === targetIdx) return;
    if (type === "kanji") {
      let decks = getKanjiDecks(); let [moved] = decks.splice(dragSrcIdx, 1); decks.splice(targetIdx, 0, moved);
      saveKanjiDecksRaw(decks); currentKanjiDeck = targetIdx; loadKanjiDeck(currentKanjiDeck);
    } else {
      saveNotesDeck(); let decks = getNotesDecks(); let [moved] = decks.splice(dragSrcIdx, 1); decks.splice(targetIdx, 0, moved);
      saveNotesDecksRaw(decks); currentNotesDeck = targetIdx;
      document.getElementById("editor").innerHTML = decks[targetIdx]?.content || "";
      updateTOC(); rebindNotes(); renderSidebar();
    }
  });
}

/* ============================================================
   SIDEBAR RENDER
============================================================ */
function renderSidebar() {
  let searchInp = document.getElementById("deckSearch"), searchVal = (searchInp?.value || "").toLowerCase();
  let sb = document.getElementById("sidebar"); sb.innerHTML = ""; sb.appendChild(searchInp);

  let h1 = document.createElement("h4"); h1.textContent = "📇 Kanji Decks"; sb.appendChild(h1);
  let r1 = document.createElement("div"); r1.className = "sidebar-btn-row";
  let b1 = document.createElement("button"); b1.textContent = "➕ Thêm"; b1.onclick = addKanjiDeck; r1.appendChild(b1);
  let b2 = document.createElement("button"); b2.textContent = "🗑 Xóa"; b2.onclick = deleteSelectedKanji; r1.appendChild(b2);
  let b3 = document.createElement("button"); b3.textContent = "A-Z"; b3.onclick = () => { let d = getKanjiDecks().slice().sort((a,b)=>(a.name||"").localeCompare(b.name||"")); saveKanjiDecksRaw(d); loadKanjiDeck(0); }; r1.appendChild(b3);
  sb.appendChild(r1);

  getKanjiDecks().forEach((d, i) => {
    let label = d.name || ("Deck "+(i+1));
    if (searchVal && !label.toLowerCase().includes(searchVal)) return;
    let prog = getDeckProgress(d);
    let row = document.createElement("div");
    row.className = "deck" + (i===currentKanjiDeck&&currentSheet===1?" active-deck":"");
    let numEl = document.createElement("span"); numEl.className = "deck-num"; numEl.textContent = i+1;
    let nameEl = document.createElement("span"); nameEl.className = "deck-name"; nameEl.textContent = label;
    nameEl.ondblclick = e => { e.stopPropagation(); renameKanjiDeck(i); };
    let renameBtn = document.createElement("button"); renameBtn.className = "deck-rename-btn"; renameBtn.textContent = "✏️";
    renameBtn.title = "Đổi tên deck"; renameBtn.onclick = e => { e.stopPropagation(); renameKanjiDeck(i); };
    let progEl = document.createElement("span"); progEl.className = "deck-prog"; progEl.textContent = prog.total > 0 ? prog.known+"/"+prog.total : "";
    let chk = document.createElement("div"); chk.className = "checkBox" + (selectedKanjiDecks.has(i)?" active":"");
    row.onclick = () => { switchSheet(1); loadKanjiDeck(i); };
    chk.onclick = e => { e.stopPropagation(); selectedKanjiDecks.has(i) ? selectedKanjiDecks.delete(i) : selectedKanjiDecks.add(i); chk.classList.toggle("active"); };
    row.appendChild(numEl); row.appendChild(nameEl); row.appendChild(renameBtn); row.appendChild(progEl); row.appendChild(chk);
    makeDraggableDeck(row, "kanji", i); sb.appendChild(row);
  });

  let h2 = document.createElement("h4"); h2.textContent = "📝 Notes"; sb.appendChild(h2);
  let r2 = document.createElement("div"); r2.className = "sidebar-btn-row";
  let bn1 = document.createElement("button"); bn1.textContent = "➕ Thêm"; bn1.onclick = addNotesDeck; r2.appendChild(bn1);
  let bn2 = document.createElement("button"); bn2.textContent = "🗑 Xóa"; bn2.onclick = deleteSelectedNotes; r2.appendChild(bn2);
  sb.appendChild(r2);

  let nd = getNotesDecks();
  if (nd.length === 0) { nd.push({content:""}); saveNotesDecksRaw(nd); }
  nd.forEach((d, i) => {
    let label = d.name || ("Note "+(i+1));
    if (searchVal && !label.toLowerCase().includes(searchVal)) return;
    let row = document.createElement("div");
    row.className = "deck" + (i===currentNotesDeck&&currentSheet===2?" active-deck":"");
    let numEl = document.createElement("span"); numEl.className = "deck-num"; numEl.textContent = i+1;
    let nameEl = document.createElement("span"); nameEl.className = "deck-name"; nameEl.textContent = label;
    nameEl.ondblclick = e => { e.stopPropagation(); renameNotesDeck(i); };
    let renameBtn = document.createElement("button"); renameBtn.className = "deck-rename-btn"; renameBtn.textContent = "✏️";
    renameBtn.title = "Đổi tên note"; renameBtn.onclick = e => { e.stopPropagation(); renameNotesDeck(i); };
    let chk = document.createElement("div"); chk.className = "checkBox" + (selectedNotesDecks.has(i)?" active":"");
    row.onclick = () => { switchSheet(2); loadNotesDeck(i); };
    chk.onclick = e => { e.stopPropagation(); selectedNotesDecks.has(i) ? selectedNotesDecks.delete(i) : selectedNotesDecks.add(i); chk.classList.toggle("active"); };
    row.appendChild(numEl); row.appendChild(nameEl); row.appendChild(renameBtn); row.appendChild(chk);
    makeDraggableDeck(row, "notes", i); sb.appendChild(row);
  });
}

