/* ============================================================
   DECK UNDO / REDO SYSTEM
============================================================ */
const DECK_UNDO_MAX = 50;
let deckUndoHistory = {};

function getDeckUndoState() {
  if (!deckUndoHistory[currentKanjiDeck]) deckUndoHistory[currentKanjiDeck] = { stack: [], pointer: -1 };
  return deckUndoHistory[currentKanjiDeck];
}

function snapshotDeck() {
  let state = getDeckUndoState();
  let snapshot = cards.map(c => ({
    front: c.dataset.front, back: c.dataset.back,
    reading: c.dataset.reading || "",
    color: c.style.background, known: c.dataset.known,
    tags: JSON.parse(c.dataset.tags || "[]")
  }));
  state.stack = state.stack.slice(0, state.pointer + 1);
  state.stack.push(snapshot);
  if (state.stack.length > DECK_UNDO_MAX) state.stack.shift();
  state.pointer = state.stack.length - 1;
  updateDeckUndoButtons();
}

function deckUndo() {
  let state = getDeckUndoState();
  if (state.pointer <= 0) return;
  state.pointer--;
  restoreDeckSnapshot(state.stack[state.pointer]);
  updateDeckUndoButtons();
}

function deckRedo() {
  let state = getDeckUndoState();
  if (state.pointer >= state.stack.length - 1) return;
  state.pointer++;
  restoreDeckSnapshot(state.stack[state.pointer]);
  updateDeckUndoButtons();
}

function restoreDeckSnapshot(snapshot) {
  snapshot.forEach((d, i) => {
    if (i >= cards.length) return;
    let c = cards[i];
    c.dataset.front = d.front; c.dataset.back = d.back; c.dataset.reading = d.reading;
    c.style.background = d.color; c.dataset.known = d.known;
    c.dataset.tags = JSON.stringify(d.tags);
    c.classList.remove("back","known","unknown","empty-card");
    c.querySelector(".card-text").textContent = d.front;
    let ks = c.querySelector(".card-status");
    if (d.known === "1") { c.classList.add("known"); ks.textContent = "✓"; }
    else if (d.known === "0") { c.classList.add("unknown"); ks.textContent = "✗"; }
    else ks.textContent = "";
    if (!d.front || d.front === "□") c.classList.add("empty-card");
    let tagsEl = c.querySelector(".card-tags"); tagsEl.innerHTML = "";
    (d.tags||[]).forEach((t,ti) => {
      let chip = document.createElement("span"); chip.className = "card-tag";
      chip.style.background = TAG_COLORS[ti % TAG_COLORS.length];
      chip.textContent = t; tagsEl.appendChild(chip);
    });
  });
  saveKanjiDeck(true); updateProgress(); applyFilter();
}

function updateDeckUndoButtons() {
  let state = getDeckUndoState();
  document.getElementById("deckUndoBtn").disabled = state.pointer <= 0;
  document.getElementById("deckRedoBtn").disabled = state.pointer >= state.stack.length - 1;
}

/* ============================================================
   EDITOR UNDO / REDO
============================================================ */
const EDITOR_UNDO_MAX = 100;
let editorUndoStack = [], editorRedoStack = [];
let editorSnapshotTimer = null, editorLastSnapshot = null;

function scheduleEditorSnapshot() {
  clearTimeout(editorSnapshotTimer);
  editorSnapshotTimer = setTimeout(takeEditorSnapshot, 600);
}

function takeEditorSnapshot() {
  let html = document.getElementById("editor").innerHTML;
  if (html === editorLastSnapshot) return;
  editorUndoStack.push(html);
  if (editorUndoStack.length > EDITOR_UNDO_MAX) editorUndoStack.shift();
  editorRedoStack = [];
  editorLastSnapshot = html;
  updateEditorUndoButtons();
}

function editorUndo() {
  if (editorUndoStack.length === 0) return;
  let editor = document.getElementById("editor");
  editorRedoStack.push(editor.innerHTML);
  let prev = editorUndoStack.pop();
  editorLastSnapshot = prev;
  editor.innerHTML = prev;
  updateWordCount(); updateTOC(); updateEditorUndoButtons();
  moveCursorToEnd(editor);
}

function editorRedo() {
  if (editorRedoStack.length === 0) return;
  let editor = document.getElementById("editor");
  editorUndoStack.push(editor.innerHTML);
  let next = editorRedoStack.pop();
  editorLastSnapshot = next;
  editor.innerHTML = next;
  updateWordCount(); updateTOC(); updateEditorUndoButtons();
  moveCursorToEnd(editor);
}

function moveCursorToEnd(el) {
  el.focus();
  let range = document.createRange();
  range.selectNodeContents(el); range.collapse(false);
  let sel = window.getSelection();
  sel.removeAllRanges(); sel.addRange(range);
}

