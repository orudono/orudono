/* ============================================================
   COLOR UTILITY
============================================================ */
function parseColorInput(val) {
  val = val.trim();
  if (!val) return null;
  // hex
  if (/^#[0-9a-fA-F]{3,6}$/.test(val)) return val;
  // rgb(r,g,b)
  let rgbMatch = val.match(/rgb\s*\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*\)/i);
  if (rgbMatch) {
    let r = parseInt(rgbMatch[1]), g = parseInt(rgbMatch[2]), b = parseInt(rgbMatch[3]);
    return '#' + [r,g,b].map(x => x.toString(16).padStart(2,'0')).join('');
  }
  // plain hex without #
  if (/^[0-9a-fA-F]{6}$/.test(val)) return '#' + val;
  return null;
}

function syncColorInputs(colorPickerId, hexInputId, newColor) {
  let cp = document.getElementById(colorPickerId);
  let hi = document.getElementById(hexInputId);
  if (cp && /^#[0-9a-fA-F]{6}$/.test(newColor)) cp.value = newColor;
  if (hi) hi.value = newColor;
}

/* ============================================================
   COLOR SWATCHES INIT
============================================================ */
function buildSwatches() {
  // Text color swatches
  let ts = document.getElementById('textSwatches');
  TEXT_COLORS.forEach(c => {
    let s = document.createElement('div'); s.className = 'swatch';
    s.style.background = c; s.title = c;
    s.onclick = () => {
      currentTextColor = c;
      document.getElementById('textColorBar').style.background = c;
      syncColorInputs('textColorCustom','textColorHex',c);
      applyTextColor(); closeAllColorPickers();
    };
    ts.appendChild(s);
  });

  // Highlight swatches
  let hs = document.getElementById('hlSwatches');
  HIGHLIGHT_COLORS.forEach(c => {
    let s = document.createElement('div'); s.className = 'swatch';
    s.style.background = c; s.title = c;
    s.onclick = () => {
      currentHighlight = c;
      document.getElementById('highlightBar').style.background = c;
      syncColorInputs('highlightCustom','highlightHex',c);
      applyHighlight(); closeAllColorPickers();
    };
    hs.appendChild(s);
  });

  // Note color pickers
  let ncr = document.getElementById('noteColorRow');
  NOTE_COLORS.forEach(col => {
    let opt = document.createElement('div');
    opt.className = 'note-color-opt' + (col === 'yellow' ? ' selected' : '');
    opt.style.background = NOTE_BG[col];
    opt.style.border = '3px solid ' + NOTE_BORDER[col];
    opt.title = col;
    opt.onclick = () => {
      pendingNoteColor = col;
      document.querySelectorAll('.note-color-opt').forEach(o => o.classList.remove('selected'));
      opt.classList.add('selected');
    };
    ncr.appendChild(opt);
  });

  // Sync color inputs
  document.getElementById('textColorCustom').oninput = e => {
    document.getElementById('textColorHex').value = e.target.value;
  };
  document.getElementById('highlightCustom').oninput = e => {
    document.getElementById('highlightHex').value = e.target.value;
  };

  renderCustomColors();
}

function renderCustomColors() {
  // Text custom colors
  let tc = document.getElementById('textCustomColors');
  if (tc) {
    tc.innerHTML = '';
    customTextColors.forEach((c, i) => {
      let s = document.createElement('div');
      s.className = 'swatch removable'; s.style.background = c; s.title = c;
      let del = document.createElement('div'); del.className = 'custom-color-del'; del.textContent = '✕';
      del.onclick = e => { e.stopPropagation(); customTextColors.splice(i,1); localStorage.setItem('customTextColors',JSON.stringify(customTextColors)); renderCustomColors(); };
      s.appendChild(del);
      s.onclick = () => {
        currentTextColor = c;
        document.getElementById('textColorBar').style.background = c;
        syncColorInputs('textColorCustom','textColorHex',c);
        applyTextColor(); closeAllColorPickers();
      };
      tc.appendChild(s);
    });
    if (customTextColors.length === 0) {
      let hint = document.createElement('span'); hint.style.cssText = 'font-size:10px;color:var(--text-muted);font-style:italic;';
      hint.textContent = 'Chưa có màu tùy chỉnh'; tc.appendChild(hint);
    }
  }

  // Highlight custom colors
  let hc = document.getElementById('hlCustomColors');
  if (hc) {
    hc.innerHTML = '';
    customHighlightColors.forEach((c, i) => {
      let s = document.createElement('div');
      s.className = 'swatch removable'; s.style.background = c; s.title = c;
      let del = document.createElement('div'); del.className = 'custom-color-del'; del.textContent = '✕';
      del.onclick = e => { e.stopPropagation(); customHighlightColors.splice(i,1); localStorage.setItem('customHighlightColors',JSON.stringify(customHighlightColors)); renderCustomColors(); };
      s.appendChild(del);
      s.onclick = () => {
        currentHighlight = c;
        document.getElementById('highlightBar').style.background = c;
        syncColorInputs('highlightCustom','highlightHex',c);
        applyHighlight(); closeAllColorPickers();
      };
      hc.appendChild(s);
    });
    if (customHighlightColors.length === 0) {
      let hint = document.createElement('span'); hint.style.cssText = 'font-size:10px;color:var(--text-muted);font-style:italic;';
      hint.textContent = 'Chưa có màu tùy chỉnh'; hc.appendChild(hint);
    }
  }
}

function addCustomTextColor() {
  let hexInp = document.getElementById('textColorHex').value;
  let cpInp = document.getElementById('textColorCustom').value;
