function buildGridPicker() {
  let container = document.getElementById("gridSizeGrid");
  for (let r = 1; r <= 10; r++) {
    for (let c = 1; c <= 10; c++) {
      let cell = document.createElement("div"); cell.className = "gsCell";
      cell.dataset.r = r; cell.dataset.c = c;
      cell.addEventListener("mouseenter", () => highlightPicker(c, r));
      cell.addEventListener("click", () => applyGridSize(c, r));
      container.appendChild(cell);
    }
  }
}

function highlightPicker(cols, rows) {
  document.querySelectorAll(".gsCell").forEach(cell => {
    cell.classList.toggle("hover", +cell.dataset.c <= cols && +cell.dataset.r <= rows);
  });
  document.getElementById("gridSizeLabel").textContent = cols + " × " + rows + " = " + (cols * rows) + " thẻ";
}

function applyGridSize(cols, rows) {
  gridCols = cols; gridRows = rows;
  document.getElementById("gridSizePicker").style.display = "none";
  document.getElementById("gridSizeBtn").textContent = cols + " × " + rows + " ▾";
  rebuildGrid();
