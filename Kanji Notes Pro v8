<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title>Kanji Notes Pro v8</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;700&family=Noto+Sans+JP:wght@400;700&family=Zen+Antique&family=Shippori+Mincho:wght@400;700&family=Kaisei+Opti&family=Lora:ital,wght@0,400;0,700;1,400&family=Playfair+Display:wght@400;700&family=Source+Serif+4:wght@400;700&family=EB+Garamond:wght@400;700&family=Crimson+Pro:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<style>
/* ── THEME VARIABLES ── */
:root {
  --bg: #f0f0f0;
  --sidebar-bg: #111;
  --sidebar-text: #ffffff;
  --sidebar-item: #2a2a2a;
  --sidebar-hover: #3a3a3a;
  --sidebar-active: #1a3a5a;
  --sidebar-border: #4a8ac4;
  --topbar-bg: #222;
  --topbar-text: #ffffff;
  --card-bg: #ffffff;
  --card-border: #cccccc;
  --card-known: #4caf50;
  --card-unknown: #f44336;
  --editor-bg: #ffffff;
  --editor-wrap: #e8e8e8;
  --toolbar-bg: #dddddd;
  --toolbar-border: #bbbbbb;
  --sheet1ctrl-bg: #f8f8f8;
  --progress-bg: #dddddd;
  --progress-fill: #4caf50;
  --text-main: #000000;
  --text-muted: #666666;
  --accent: #4a8ac4;
  --overlay-bg: rgba(0,0,0,0.85);
  --modal-bg: #ffffff;
  --modal-border: #dddddd;
  --input-bg: #ffffff;
  --input-border: #cccccc;
  --tag-bg: #e0e0e0;
  --tag-text: #333333;
}

* { box-sizing: border-box; }
body {
  margin: 0; display: flex; height: 100vh;
  font-family: "MS Mincho", serif;
  background: var(--bg); overflow: hidden;
  color: var(--text-main);
  transition: background .2s, color .2s;
}

/* ── SIDEBAR ── */
#sidebar {
  width: 220px; min-width: 140px; max-width: 360px;
  background: var(--sidebar-bg); color: var(--sidebar-text);
  padding: 8px; overflow-y: auto; flex-shrink: 0; user-select: none;
  display: flex; flex-direction: column;
}
#sidebarResizer {
  width: 5px; background: #333; cursor: col-resize;
  flex-shrink: 0; transition: background .15s;
}
#sidebarResizer:hover { background: #666; }
#sidebar h4 {
  color: #aaa; margin: 10px 0 4px; font-size: 11px;
  text-transform: uppercase; letter-spacing: 1px;
  padding: 4px 2px 8px; border-top: 1px solid #333;
}
#sidebar h4:first-of-type { border-top: none; margin-top: 0; }
.sidebar-btn-row { display: flex; gap: 4px; margin-bottom: 4px; }
.sidebar-btn-row button {
  flex: 1; font-size: 11px; padding: 4px;
  border: none; border-radius: 4px; cursor: pointer;
  background: #444; color: white;
}
.sidebar-btn-row button:hover { background: #666; }
#deckSearch {
  width: 100%; padding: 5px 7px; border-radius: 5px;
  border: none; background: #2a2a2a; color: white;
  font-size: 12px; margin-bottom: 6px; outline: none;
}
#deckSearch::placeholder { color: #666; }
.deck {
  padding: 6px 8px; background: var(--sidebar-item);
  border-radius: 8px; margin: 3px 0; cursor: pointer;
  display: flex; align-items: center; gap: 5px;
  border: 1px solid transparent; transition: background .12s;
  position: relative;
}
.deck:hover { background: var(--sidebar-hover); }
.deck.active-deck { background: var(--sidebar-active); border-color: var(--sidebar-border); }
.deck.drag-over { border-color: var(--accent); border-style: dashed; }
.deck-num { font-size: 10px; color: #666; min-width: 14px; }
.deck-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; }
.deck-prog { font-size: 10px; color: #aaa; white-space: nowrap; }
.deck-rename-btn {
  opacity: 0; border: none; background: rgba(255,255,255,.15);
  color: #aaa; font-size: 10px; border-radius: 3px;
  cursor: pointer; padding: 1px 4px; transition: opacity .15s;
}
.deck:hover .deck-rename-btn { opacity: 1; }
.deck-rename-btn:hover { background: rgba(255,255,255,.25); color: white; }
.checkBox {
  width: 14px; height: 14px; border: 2px solid #666;
  border-radius: 3px; cursor: pointer; flex-shrink: 0;
  transition: background .1s, border-color .1s;
}
.checkBox.active { background: white; border-color: white; }

/* ── MAIN ── */
#main { flex: 1; display: flex; flex-direction: column; min-width: 0; }
#topbar {
  background: var(--topbar-bg); color: var(--topbar-text);
  padding: 5px 8px; display: flex; gap: 4px;
  align-items: center; flex-wrap: wrap;
}
#topbar button {
  padding: 3px 8px; border: 1px solid #555;
  border-radius: 4px; background: #333;
  color: white; cursor: pointer; font-size: 12px;
}
#topbar button:hover { background: #555; }
#topbar button:disabled { opacity: 0.35; cursor: not-allowed; }
#topbar button:disabled:hover { background: #333; }
.tb-sep { width: 1px; height: 20px; background: #444; margin: 0 2px; }
#palette { display: flex; gap: 4px; align-items: center; }
.colorBox {
  width: 18px; height: 18px; border-radius: 4px;
  border: 2px solid transparent; cursor: pointer;
  transition: border-color .1s;
}
.colorBox:hover, .colorBox.selected { border-color: white; }

/* ── SHEETS ── */
.sheet { display: none; flex: 1; overflow: hidden; flex-direction: column; }
.sheet.active { display: flex; }

/* ── SHEET 1 ── */
#sheet1Controls {
  background: var(--sheet1ctrl-bg); border-bottom: 1px solid var(--card-border);
  padding: 5px 10px; display: flex; gap: 6px; align-items: center;
  font-size: 12px; flex-wrap: wrap; color: var(--text-main);
}
#sheet1Controls label { font-weight: bold; }
#sheet1Controls select, #sheet1Controls input[type=text] {
  padding: 2px 6px; border: 1px solid var(--input-border);
  border-radius: 4px; font-size: 12px;
  background: var(--input-bg); color: var(--text-main);
}
.ctrl-btn {
  padding: 2px 8px; font-size: 12px; border: 1px solid var(--input-border);
  border-radius: 4px; cursor: pointer; background: var(--input-bg);
  color: var(--text-main);
}
.ctrl-btn:hover { background: var(--card-border); }
.ctrl-btn.active { background: var(--accent); color: white; border-color: var(--accent); }
#filterBar {
  background: var(--sheet1ctrl-bg); border-bottom: 1px solid var(--card-border);
  padding: 4px 10px; display: flex; gap: 6px; align-items: center; font-size: 12px;
  color: var(--text-main);
}
.filter-btn {
  padding: 2px 10px; border-radius: 12px; border: 1px solid var(--input-border);
  cursor: pointer; font-size: 11px; background: var(--input-bg); color: var(--text-main);
}
.filter-btn.active { background: var(--accent); color: white; border-color: var(--accent); }
#progressBar {
  background: var(--progress-bg); padding: 4px 10px;
  display: flex; align-items: center; gap: 8px;
  font-size: 12px; border-bottom: 1px solid var(--card-border);
  color: var(--text-main);
}
#progressTrack { flex: 1; height: 6px; background: #ccc; border-radius: 3px; overflow: hidden; }
#progressFill { height: 100%; background: var(--progress-fill); border-radius: 3px; transition: width .3s; }
#flashGrid { display: grid; gap: 6px; padding: 8px; flex: 1; overflow: auto; }
.card {
  background: var(--card-bg); border-radius: 10px; border: 1px solid var(--card-border);
  display: flex; flex-direction: column; justify-content: center; align-items: center;
  cursor: pointer; user-select: none; position: relative;
  transition: box-shadow .1s, transform .08s;
  min-height: 0; overflow: hidden;
}
.card:hover { box-shadow: 0 2px 8px rgba(0,0,0,.2); transform: scale(1.02); }
.card:hover .card-quick { opacity: 1; }
.card.back { font-family: "Noto Sans", sans-serif; padding: 4px; text-align: center; }
.card.known { border-color: var(--card-known); border-width: 2px; }
.card.unknown { border-color: var(--card-unknown); border-width: 2px; }
.card.empty-card { opacity: 0.3; }
.card.selected-card { outline: 2px solid var(--accent); outline-offset: 1px; }
.card-status { position: absolute; top: 2px; right: 4px; font-size: 9px; }
.card-text { font-size: clamp(10px, 2.5vw, 32px); }
.card.back .card-text { font-size: clamp(8px, 1.2vw, 14px); line-height: 1.4; }
.card-tags { position: absolute; bottom: 2px; left: 2px; display: flex; gap: 2px; flex-wrap: wrap; }
.card-tag { font-size: 8px; padding: 1px 3px; border-radius: 3px; color: white; }
.card-quick {
  position: absolute; bottom: 0; left: 0; right: 0;
  display: flex; opacity: 0; transition: opacity .15s;
  background: rgba(0,0,0,.55);
}
.card-quick button {
  flex: 1; border: none; padding: 3px 0; font-size: 10px;
  cursor: pointer; background: transparent; color: white;
}
.card-quick button:hover { background: rgba(255,255,255,.15); }
#listView { display: none; flex: 1; overflow: auto; }
#listView.active { display: block; }
.list-table { width: 100%; border-collapse: collapse; font-size: 13px; }
.list-table th {
  background: var(--toolbar-bg); padding: 6px 10px;
  text-align: left; font-size: 11px; color: var(--text-muted);
  border-bottom: 1px solid var(--card-border); position: sticky; top: 0;
}
.list-table td { padding: 5px 10px; border-bottom: 0.5px solid var(--card-border); color: var(--text-main); }
.list-table tr:hover td { background: var(--sheet1ctrl-bg); }
.list-status { font-size: 11px; padding: 1px 6px; border-radius: 10px; }
.ls-known { background: #e8f5e9; color: #2e7d32; }
.ls-unknown { background: #ffebee; color: #c62828; }
.ls-none { background: var(--tag-bg); color: var(--tag-text); }
#multiSelectBar {
  display: none; position: absolute; bottom: 60px; left: 50%;
  transform: translateX(-50%); background: #222; color: white;
  border-radius: 8px; padding: 6px 12px; gap: 8px;
  align-items: center; font-size: 12px; z-index: 100;
  box-shadow: 0 4px 16px rgba(0,0,0,.4);
}
#multiSelectBar.visible { display: flex; }
#multiSelectBar button {
  padding: 3px 10px; border: 1px solid #555; border-radius: 4px;
  background: #444; color: white; cursor: pointer; font-size: 11px;
}
#multiSelectBar button:hover { background: #666; }

/* ── SHEET 2 LAYOUT ── */
#sheet2 { display: none; flex: 1; overflow: hidden; flex-direction: row; }
#sheet2.active { display: flex; }

/* TOC PANEL */
#tocPanel {
  width: 220px; min-width: 160px; max-width: 320px;
  background: var(--sheet1ctrl-bg);
  border-right: 1px solid var(--card-border);
  display: flex; flex-direction: column;
  flex-shrink: 0; transition: width .2s;
  overflow: hidden;
}
#tocPanel.hidden { width: 0; min-width: 0; border: none; }
#tocHeader {
  display: flex; align-items: center; justify-content: space-between;
  padding: 8px 10px; border-bottom: 1px solid var(--card-border);
  font-size: 12px; font-weight: bold; color: var(--text-muted);
}
#tocHeader span { font-size: 11px; text-transform: uppercase; letter-spacing: .8px; }
#tocList { flex: 1; overflow-y: auto; padding: 6px 0; }
.toc-item {
  display: flex; align-items: center; gap: 4px;
  padding: 5px 10px; cursor: pointer; font-size: 12px;
  color: var(--text-main); border-left: 3px solid transparent;
  transition: background .1s, border-color .1s;
  user-select: none;
}
.toc-item:hover { background: var(--card-border); border-left-color: var(--accent); }
.toc-item.toc-h1 { font-weight: bold; font-size: 13px; }
.toc-item.toc-h2 { padding-left: 20px; font-size: 12px; }
.toc-item.toc-h3 { padding-left: 30px; font-size: 11px; color: var(--text-muted); }
.toc-label { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.toc-actions { display: flex; gap: 2px; opacity: 0; transition: opacity .15s; }
.toc-item:hover .toc-actions { opacity: 1; }
.toc-act-btn {
  border: none; background: transparent; cursor: pointer;
  font-size: 11px; padding: 1px 3px; border-radius: 3px;
  color: var(--text-muted);
}
.toc-act-btn:hover { background: var(--card-border); color: var(--text-main); }
#tocResizer {
  width: 4px; background: var(--card-border); cursor: col-resize;
  flex-shrink: 0; transition: background .15s;
}
#tocResizer:hover { background: var(--accent); }

/* EDITOR AREA */
#editorArea { flex: 1; display: flex; flex-direction: column; min-width: 0; overflow: hidden; }

/* ── EDITOR TOOLBAR ── */
#editorToolbar {
  background: var(--toolbar-bg); padding: 4px 6px;
  display: flex; gap: 3px; flex-wrap: wrap;
  align-items: center; border-bottom: 1px solid var(--toolbar-border);
}
#editorToolbar button {
  padding: 2px 6px; border: 1px solid var(--toolbar-border);
  border-radius: 3px; background: var(--card-bg);
  cursor: pointer; font-size: 12px; color: var(--text-main);
  position: relative;
}
#editorToolbar button:hover { background: var(--sheet1ctrl-bg); }
#editorToolbar button:disabled { opacity: 0.35; cursor: not-allowed; }
#editorToolbar select {
  padding: 2px 4px; border: 1px solid var(--toolbar-border);
  border-radius: 3px; font-size: 12px;
  background: var(--card-bg); color: var(--text-main);
}
.tb2-sep { width: 1px; height: 20px; background: var(--toolbar-border); margin: 0 2px; }

/* ── COLOR BUTTON (Word-style) ── */
.color-tool-group {
  display: flex; align-items: stretch; border: 1px solid var(--toolbar-border);
  border-radius: 3px; overflow: hidden;
}
.color-tool-main {
  display: flex; flex-direction: column; align-items: center;
  padding: 2px 5px; background: var(--card-bg);
  cursor: pointer; gap: 1px; border: none; border-right: 1px solid var(--toolbar-border);
  min-width: 26px;
}
.color-tool-main:hover { background: var(--sheet1ctrl-bg); }
.color-tool-arrow {
  padding: 2px 3px; background: var(--card-bg); cursor: pointer;
  border: none; font-size: 8px; display: flex; align-items: center;
  color: var(--text-muted); position: relative;
}
.color-tool-arrow:hover { background: var(--sheet1ctrl-bg); }
.color-bar { width: 16px; height: 3px; border-radius: 1px; margin-top: 1px; }
.color-picker-popup {
  display: none; position: absolute; top: 100%; left: 0;
  background: var(--modal-bg); border: 1px solid var(--card-border);
  border-radius: 8px; padding: 10px; z-index: 400;
  box-shadow: 0 4px 16px rgba(0,0,0,.2); min-width: 240px;
}
.color-picker-popup.open { display: block; }
.color-swatches {
  display: grid; grid-template-columns: repeat(10, 18px); gap: 2px; margin-bottom: 8px;
}
.swatch {
  width: 18px; height: 18px; border-radius: 3px; cursor: pointer;
  border: 1px solid rgba(0,0,0,.1); transition: transform .1s;
  position: relative;
}
.swatch:hover { transform: scale(1.2); border-color: #000; }
.swatch.none-swatch {
  background: white;
  overflow: hidden;
}
.swatch.none-swatch::before {
  content: '';
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, white 45%, #e53935 47%, #e53935 53%, white 55%);
}
.color-custom-row {
  display: flex; align-items: center; gap: 6px; margin-top: 6px; flex-wrap: wrap;
}
.color-custom-row label { font-size: 11px; color: var(--text-muted); width: 100%; }
.color-custom-row input[type=color] { width: 32px; height: 26px; border: none; border-radius: 3px; cursor: pointer; padding: 0; }
.color-custom-row input[type=text] {
  flex: 1; padding: 3px 6px; font-size: 11px; border: 1px solid var(--input-border);
  border-radius: 3px; background: var(--input-bg); color: var(--text-main); min-width: 0;
}
.color-custom-row button { padding: 3px 10px; font-size: 11px; border-radius: 4px; border: 1px solid var(--input-border); cursor: pointer; background: var(--accent); color: white; white-space: nowrap; }
.color-section-label { font-size: 10px; color: var(--text-muted); text-transform: uppercase; letter-spacing: .5px; margin: 6px 0 3px; }
.custom-color-row {
  display: flex; flex-wrap: wrap; gap: 2px; margin-bottom: 4px; min-height: 18px;
}
.custom-color-del { position: absolute; top: -4px; right: -4px; width: 10px; height: 10px; background: #e53935; border-radius: 50%; font-size: 7px; color: white; display: flex; align-items: center; justify-content: center; cursor: pointer; opacity: 0; }
.swatch:hover .custom-color-del { opacity: 1; }
.swatch.removable { position: relative; }

#wordCount { font-size: 11px; color: var(--text-muted); padding: 2px 6px; }
#editorWrap { flex: 1; overflow-y: auto; background: var(--editor-wrap); padding: 20px; }
#editor {
  background: var(--editor-bg); color: var(--text-main);
  width: 210mm; min-height: 297mm; margin: auto;
  padding: 20mm 25mm; box-shadow: 0 0 8px rgba(0,0,0,.2);
  outline: none; line-height: 1.8; font-size: 14pt;
}
#findBar {
  display: none; background: var(--sheet1ctrl-bg);
  padding: 4px 10px; gap: 6px; align-items: center;
  border-bottom: 1px solid var(--card-border); font-size: 12px;
}
#findBar.active { display: flex; }
#findBar input {
  padding: 3px 8px; border: 1px solid var(--input-border);
  border-radius: 4px; font-size: 12px; width: 160px;
  background: var(--input-bg); color: var(--text-main);
}
#findBar button {
  padding: 3px 8px; font-size: 12px; border: 1px solid var(--input-border);
  border-radius: 4px; cursor: pointer; background: var(--input-bg);
  color: var(--text-main);
}

/* ── INLINE NOTE TOOLTIP ── */
.inline-note {
  background: #fffde7;
  border-bottom: 2px dashed #f9a825;
  cursor: help;
  position: relative;
  border-radius: 2px;
  padding: 0 1px;
}
.inline-note::after {
  content: attr(data-note);
  position: absolute;
  bottom: calc(100% + 6px);
  left: 50%; transform: translateX(-50%);
  background: #1a1a2e; color: #e8e8f0;
  font-size: 12px; line-height: 1.5;
  padding: 6px 10px; border-radius: 6px;
  white-space: pre-wrap; max-width: 280px; min-width: 120px;
  box-shadow: 0 4px 16px rgba(0,0,0,.35);
  pointer-events: none; opacity: 0;
  transition: opacity .18s, transform .18s;
  transform: translateX(-50%) translateY(4px);
  z-index: 9999;
  font-family: "Noto Sans JP", sans-serif;
}
.inline-note::before {
  content: '';
  position: absolute; bottom: calc(100% + 1px); left: 50%;
  transform: translateX(-50%);
  border: 5px solid transparent;
  border-top-color: #1a1a2e;
  opacity: 0; transition: opacity .18s;
  z-index: 9999; pointer-events: none;
}
.inline-note:hover::after,
.inline-note:hover::before { opacity: 1; transform: translateX(-50%) translateY(0); }
.inline-note:hover::before { transform: translateX(-50%); }
.inline-note[data-color="yellow"] { background: #fffde7; border-bottom-color: #f9a825; }
.inline-note[data-color="green"]  { background: #e8f5e9; border-bottom-color: #43a047; }
.inline-note[data-color="blue"]   { background: #e3f2fd; border-bottom-color: #1e88e5; }
.inline-note[data-color="pink"]   { background: #fce4ec; border-bottom-color: #e91e63; }
.inline-note[data-color="purple"] { background: #f3e5f5; border-bottom-color: #8e24aa; }
.inline-note[data-color="red"]    { background: #ffebee; border-bottom-color: #e53935; }

/* ── SELECTION POPUP ── */
#selPopup {
  display: none; position: fixed; z-index: 500;
  background: #1e1e2e; color: white;
  border-radius: 8px; padding: 4px 6px;
  gap: 2px; align-items: center;
  box-shadow: 0 4px 20px rgba(0,0,0,.45);
  flex-wrap: wrap; max-width: 320px;
  border: 1px solid #3a3a5a;
}
#selPopup.visible { display: flex; }
.sel-btn {
  padding: 3px 8px; border: none; border-radius: 5px;
  cursor: pointer; font-size: 11px; font-weight: 500;
  background: transparent; color: #ddd;
  transition: background .12s; white-space: nowrap;
}
.sel-btn:hover { background: rgba(255,255,255,.12); color: white; }
.sel-sep { width: 1px; height: 18px; background: #3a3a5a; margin: 0 1px; }

/* ── NOTE MODAL ── */
#noteModal {
  display: none; position: fixed; inset: 0;
  background: rgba(0,0,0,.4); z-index: 800;
  align-items: center; justify-content: center;
}
#noteModal.active { display: flex; }
#noteModalBox {
  background: var(--modal-bg); border-radius: 12px;
  padding: 20px 24px; min-width: 340px; max-width: 460px;
  border: 1px solid var(--modal-border);
  box-shadow: 0 8px 32px rgba(0,0,0,.25);
  color: var(--text-main);
}
#noteModalBox h3 { margin: 0 0 14px; font-size: 15px; }
#noteModalBox label { font-size: 11px; color: var(--text-muted); display: block; margin-bottom: 4px; }
#noteText {
  width: 100%; min-height: 80px; resize: vertical;
  padding: 8px 10px; border: 1px solid var(--input-border);
  border-radius: 6px; font-size: 13px; margin-bottom: 12px;
  background: var(--input-bg); color: var(--text-main);
  font-family: "Noto Sans JP", sans-serif;
}
.note-color-row { display: flex; gap: 6px; margin-bottom: 14px; flex-wrap: wrap; }
.note-color-opt {
  width: 24px; height: 24px; border-radius: 5px;
  cursor: pointer; border: 2px solid transparent;
  transition: border-color .1s, transform .1s;
}
.note-color-opt:hover { transform: scale(1.15); }
.note-color-opt.selected { border-color: #333; transform: scale(1.15); }
.note-modal-btns { display: flex; gap: 8px; justify-content: flex-end; }
.note-modal-btns button {
  padding: 7px 16px; border-radius: 6px; border: none;
  font-size: 13px; cursor: pointer;
}

/* ── TOC HEADING MARKER ── */
[data-toc-id] { scroll-margin-top: 20px; }

/* ── MODALS (shared) ── */
.modal-overlay {
  display: none; position: fixed; inset: 0;
  background: rgba(0,0,0,.5); z-index: 800;
  align-items: center; justify-content: center;
}
.modal-overlay.active { display: flex; }
.modal {
  background: var(--modal-bg); border-radius: 12px;
  padding: 20px 24px; min-width: 320px; max-width: 480px;
  border: 1px solid var(--modal-border);
  box-shadow: 0 8px 32px rgba(0,0,0,.25);
  color: var(--text-main);
}
.modal h3 { margin: 0 0 16px; font-size: 16px; }
.modal label { font-size: 12px; color: var(--text-muted); display: block; margin-bottom: 3px; }
.modal input, .modal textarea, .modal select {
  width: 100%; padding: 7px 10px; border: 1px solid var(--input-border);
  border-radius: 6px; font-size: 14px; margin-bottom: 12px;
  background: var(--input-bg); color: var(--text-main);
  font-family: "MS Mincho", serif;
}
.modal textarea { min-height: 120px; resize: vertical; }
.modal-btns { display: flex; gap: 8px; justify-content: flex-end; margin-top: 4px; }
.modal-btns button { padding: 7px 18px; border-radius: 6px; border: none; font-size: 13px; cursor: pointer; }
.btn-primary { background: var(--accent); color: white; }
.btn-secondary { background: var(--tag-bg); color: var(--text-main); }
.tag-input-row { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 10px; }
.tag-chip { font-size: 11px; padding: 2px 8px; border-radius: 10px; color: white; cursor: pointer; display: flex; align-items: center; gap: 3px; }
.tag-chip .rm { font-size: 10px; opacity: .7; }

/* ── RENAME MODAL ── */
#renameModal {
  display: none; position: fixed; inset: 0;
  background: rgba(0,0,0,.4); z-index: 900;
  align-items: center; justify-content: center;
}
#renameModal.active { display: flex; }
#renameModalBox {
  background: var(--modal-bg); border-radius: 12px;
  padding: 20px 24px; min-width: 320px; max-width: 400px;
  border: 1px solid var(--modal-border);
  box-shadow: 0 8px 32px rgba(0,0,0,.25);
  color: var(--text-main);
}
#renameModalBox h3 { margin: 0 0 14px; font-size: 15px; }
#renameInput {
  width: 100%; padding: 8px 10px; border: 1px solid var(--input-border);
  border-radius: 6px; font-size: 14px; margin-bottom: 14px;
  background: var(--input-bg); color: var(--text-main);
  font-family: inherit;
}
.rename-btns { display: flex; gap: 8px; justify-content: flex-end; }
.rename-btns button { padding: 7px 16px; border-radius: 6px; border: none; font-size: 13px; cursor: pointer; }

/* ── GRID SIZE PICKER ── */
#gridSizePicker {
  display: none; position: absolute;
  background: var(--modal-bg); border: 1px solid var(--card-border);
  border-radius: 10px; padding: 12px;
  box-shadow: 0 4px 20px rgba(0,0,0,.2); z-index: 500;
}
#gridSizeGrid { display: grid; grid-template-columns: repeat(10, 22px); gap: 3px; margin-bottom: 8px; }
.gsCell {
  width: 22px; height: 22px; border-radius: 4px;
  border: 1px solid var(--card-border); cursor: pointer;
  background: var(--sheet1ctrl-bg); transition: background .08s;
}
.gsCell.hover { background: var(--accent); border-color: var(--accent); }
#gridSizeLabel { font-size: 12px; text-align: center; color: var(--text-muted); }

/* ── STUDY OVERLAY ── */
#studyOverlay {
  display: none; position: fixed; inset: 0;
  background: var(--overlay-bg); z-index: 1000;
  flex-direction: column; align-items: center; justify-content: center;
}
#studyOverlay.active { display: flex; }
#studyClose { position: absolute; top: 14px; right: 18px; background: transparent; border: none; color: white; font-size: 22px; cursor: pointer; }
#studyHeader { color: white; margin-bottom: 18px; text-align: center; }
#studyDeckName { font-size: 18px; font-weight: bold; }
#studyProgress, #studyScore { font-size: 13px; color: #aaa; margin-top: 4px; }
#studyCard {
  background: var(--card-bg); border-radius: 20px;
  width: min(500px, 90vw); min-height: 270px;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 32px; text-align: center; position: relative;
  cursor: pointer; box-shadow: 0 8px 40px rgba(0,0,0,.5); transition: transform .1s;
  color: var(--text-main);
}
#studyCard:active { transform: scale(.97); }
#studyTimer { position: absolute; top: 12px; right: 16px; font-size: 13px; color: #999; }
#studyFront { font-size: 76px; line-height: 1.1; }
#studyReading { font-size: 18px; color: #888; margin-top: 4px; display: none; }
#studyBack { font-size: 18px; font-family: "Noto Sans", sans-serif; color: #444; margin-top: 12px; display: none; }
#studyHint, #studyShortcuts { font-size: 12px; color: #aaa; margin-top: 6px; }
#studyControls { display: flex; gap: 14px; margin-top: 22px; }
#studyControls button { padding: 10px 26px; border: none; border-radius: 10px; font-size: 15px; cursor: pointer; font-weight: bold; transition: transform .1s; }
#studyControls button:active { transform: scale(.95); }
#btnKnown { background: #4caf50; color: white; }
#btnUnknown { background: #f44336; color: white; }
#btnSkip { background: #888; color: white; }
#studyResult { display: none; color: white; text-align: center; }
#studyResult h2 { font-size: 28px; margin-bottom: 10px; }
#studyResult p { color: #ccc; font-size: 15px; white-space: pre-line; }
#studyResult .res-btns { display: flex; gap: 10px; justify-content: center; margin-top: 18px; }
#studyResult button { padding: 10px 22px; border-radius: 10px; border: none; font-size: 14px; cursor: pointer; }

/* ── THEME PANEL ── */
#themePanel {
  display: none; position: fixed; top: 38px; right: 8px;
  background: var(--modal-bg); border: 1px solid var(--modal-border);
  border-radius: 12px; padding: 16px; z-index: 600;
  box-shadow: 0 4px 24px rgba(0,0,0,.2); width: 320px;
  color: var(--text-main); max-height: 85vh; overflow-y: auto;
}
#themePanel.active { display: block; }
#themePanel h4 { margin: 0 0 10px; font-size: 13px; }
.theme-presets { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 12px; }
.theme-preset {
  padding: 4px 8px; border-radius: 6px; border: 1px solid var(--card-border);
  cursor: pointer; font-size: 11px; background: var(--input-bg); color: var(--text-main);
  display: flex; align-items: center; gap: 4px;
}
.theme-preset:hover { border-color: var(--accent); }
.theme-palette-dot {
  display: flex; gap: 2px;
}
.theme-palette-dot span {
  width: 8px; height: 8px; border-radius: 50%; display: inline-block;
}
.theme-section-label { font-size: 10px; color: var(--text-muted); text-transform: uppercase; letter-spacing: .5px; margin: 10px 0 6px; font-weight: bold; }
.theme-row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; font-size: 12px; }
.theme-row label { flex: 1; }
.theme-row input[type=color] { width: 32px; height: 24px; border: none; border-radius: 4px; cursor: pointer; padding: 0; }
.theme-row input[type=text] {
  width: 80px; padding: 3px 6px; border: 1px solid var(--input-border);
  border-radius: 4px; font-size: 11px; background: var(--input-bg); color: var(--text-main);
}

/* ── STATS PANEL ── */
#statsPanel {
  display: none; position: fixed; top: 38px; left: 50%; transform: translateX(-50%);
  background: var(--modal-bg); border: 1px solid var(--modal-border);
  border-radius: 12px; padding: 20px; z-index: 600;
  box-shadow: 0 4px 24px rgba(0,0,0,.2); width: 420px;
  color: var(--text-main);
}
#statsPanel.active { display: block; }
#statsPanel h4 { margin: 0 0 14px; font-size: 15px; }
.stats-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 10px; margin-bottom: 16px; }
.stat-card { background: var(--sheet1ctrl-bg); border-radius: 8px; padding: 10px; text-align: center; }
.stat-num { font-size: 22px; font-weight: bold; color: var(--accent); }
.stat-label { font-size: 11px; color: var(--text-muted); margin-top: 2px; }
.streak-row { display: flex; gap: 3px; flex-wrap: wrap; }
.streak-cell { width: 14px; height: 14px; border-radius: 3px; background: var(--tag-bg); cursor: default; }
.streak-cell.s1 { background: #c6e48b; }
.streak-cell.s2 { background: #7bc96f; }
.streak-cell.s3 { background: #239a3b; }
.streak-cell.s4 { background: #196127; }

@media print {
  body > *:not(#printFrame) { display: none !important; }
  #printFrame { display: block !important; position: fixed; inset: 0; width: 100%; height: 100%; border: none; }
}
</style>
</head>
<body>

<!-- SIDEBAR -->
<div id="sidebar">
  <input id="deckSearch" type="text" placeholder="🔍 Tìm deck / note…" oninput="renderSidebar()">
</div>
<div id="sidebarResizer"></div>

<!-- MAIN -->
<div id="main">
  <div id="topbar">
    <button onclick="switchSheet(1)">📇 Sheet 1</button>
    <button onclick="switchSheet(2)">📝 Sheet 2</button>
    <div class="tb-sep"></div>
    <div id="palette"></div>
    <button onclick="addColor()">+🎨</button>
    <div class="tb-sep"></div>
    <button onclick="shuffleCards()">🔀</button>
    <button onclick="openStudy()">📖 Study</button>
    <button onclick="resetProgress()">↺</button>
    <div class="tb-sep"></div>
    <button id="deckUndoBtn" onclick="deckUndo()" title="Undo (Ctrl+Z)" disabled>↩ Undo</button>
    <button id="deckRedoBtn" onclick="deckRedo()" title="Redo (Ctrl+Y)" disabled>↪ Redo</button>
    <div class="tb-sep"></div>
    <button onclick="showStats()">📊</button>
    <div class="tb-sep"></div>
    <button onclick="exportDeck()">⬆ Export</button>
    <button onclick="showImportMenu()">⬇ Import</button>
    <div class="tb-sep"></div>
    <button onclick="toggleThemePanel()">🎨 Theme</button>
  </div>

  <!-- SHEET 1 -->
  <div id="sheet1" class="sheet active">
    <div id="sheet1Controls">
      <label>Grid:</label>
      <div style="position:relative;display:inline-block;">
        <button id="gridSizeBtn" class="ctrl-btn" onclick="toggleGridPicker(event)">6 × 5 ▾</button>
        <div id="gridSizePicker">
          <div id="gridSizeGrid"></div>
          <div id="gridSizeLabel">6 × 5 = 30 thẻ</div>
        </div>
      </div>
      <div class="tb-sep" style="background:var(--card-border)"></div>
      <label>Font:</label>
      <select id="cardFontSelect" onchange="applyCardFont(this.value)">
        <optgroup label="Chữ Nhật">
          <option value="'MS Mincho',serif">MS Mincho</option>
          <option value="'Noto Serif JP',serif">Noto Serif JP</option>
          <option value="'Shippori Mincho',serif">Shippori Mincho</option>
          <option value="'Noto Sans JP',sans-serif">Noto Sans JP</option>
          <option value="'Zen Antique',serif">Zen Antique</option>
          <option value="'Kaisei Opti',serif">Kaisei Opti</option>
        </optgroup>
        <optgroup label="Chữ Latin">
          <option value="'Times New Roman',serif">Times New Roman</option>
          <option value="'Lora',serif">Lora</option>
          <option value="'Playfair Display',serif">Playfair Display</option>
          <option value="'EB Garamond',serif">EB Garamond</option>
          <option value="'Crimson Pro',serif">Crimson Pro</option>
          <option value="'Georgia',serif">Georgia</option>
          <option value="'Arial',sans-serif">Arial</option>
        </optgroup>
      </select>
      <div class="tb-sep" style="background:var(--card-border)"></div>
      <button class="ctrl-btn" onclick="toggleView()" id="viewToggleBtn">📋 List</button>
      <button class="ctrl-btn" onclick="revealAll()" id="revealAllBtn">👁 Reveal All</button>
      <button class="ctrl-btn" onclick="openBulkImport()">📥 Bulk Import</button>
    </div>
    <div id="filterBar">
      <span style="font-size:11px;color:var(--text-muted)">Lọc:</span>
      <button class="filter-btn active" onclick="setFilter('all',this)">Tất cả</button>
      <button class="filter-btn" onclick="setFilter('known',this)">✓ Thuộc</button>
      <button class="filter-btn" onclick="setFilter('unknown',this)">✗ Chưa thuộc</button>
      <button class="filter-btn" onclick="setFilter('none',this)">○ Chưa học</button>
      <span style="margin-left:auto;display:flex;align-items:center;gap:6px;">
        <span style="font-size:11px;color:var(--text-muted)">Sort:</span>
        <button class="filter-btn" onclick="sortByNumber()">🔢 Số</button>
        <button class="filter-btn" onclick="sortAlpha()">🔤 A-Z</button>
      </span>
    </div>
    <div id="progressBar">
      <span id="progressText">0 / 0 thuộc</span>
      <div id="progressTrack"><div id="progressFill" style="width:0%"></div></div>
      <span id="timerDisplay" style="cursor:pointer" onclick="toggleTimer()" title="Click để pause/resume">⏱ 00:00</span>
    </div>
    <div id="flashGrid"></div>
    <div id="listView"><table class="list-table">
      <thead><tr><th>#</th><th>Kanji</th><th>Reading</th><th>Nghĩa</th><th>Tags</th><th>Trạng thái</th><th></th></tr></thead>
      <tbody id="listBody"></tbody>
    </table></div>
    <div id="multiSelectBar">
      <span id="multiCount">0 thẻ</span>
      <button onclick="multiSetColor()">🎨 Màu</button>
      <button onclick="multiSetKnown(true)">✓ Known</button>
      <button onclick="multiSetKnown(false)">✗ Unknown</button>
      <button onclick="multiDelete()">🗑 Xóa</button>
      <button onclick="clearMultiSelect()">✕</button>
    </div>
  </div>

  <!-- SHEET 2 -->
  <div id="sheet2" class="sheet">
    <div id="tocPanel">
      <div id="tocHeader">
        <span>📑 Mục lục</span>
        <button onclick="toggleTOC()" style="border:none;background:none;cursor:pointer;font-size:14px;color:var(--text-muted)" title="Ẩn mục lục">◀</button>
      </div>
      <div id="tocList"></div>
    </div>
    <div id="tocResizer"></div>
    <div id="editorArea">
      <div id="editorToolbar">
        <button id="editorUndoBtn" onclick="editorUndo()" title="Undo (Ctrl+Z)" disabled>↩</button>
        <button id="editorRedoBtn" onclick="editorRedo()" title="Redo (Ctrl+Y)" disabled>↪</button>
        <div class="tb2-sep"></div>
        <button id="tocToggleBtn" onclick="toggleTOC()" title="Hiện/Ẩn mục lục" style="font-size:13px;">📑</button>
        <div class="tb2-sep"></div>
        <button onclick="format('bold')"><b>B</b></button>
        <button onclick="format('italic')"><i>I</i></button>
        <button onclick="format('underline')"><u>U</u></button>
        <button onclick="format('strikeThrough')"><s>S</s></button>
        <div class="tb2-sep"></div>
        <select onchange="applyHeading(this.value)">
          <option value="div">Paragraph</option>
          <option value="h1">Heading 1</option>
          <option value="h2">Heading 2</option>
          <option value="h3">Heading 3</option>
        </select>
        <div class="tb2-sep"></div>
        <button onclick="format('justifyLeft')">⬅</button>
        <button onclick="format('justifyCenter')">⬌</button>
        <button onclick="format('justifyRight')">➡</button>
        <button onclick="format('justifyFull')">☰</button>
        <div class="tb2-sep"></div>
        <button onclick="format('insertUnorderedList')">•</button>
        <button onclick="format('insertOrderedList')">1.</button>
        <button onclick="format('indent')">→</button>
        <button onclick="format('outdent')">←</button>
        <div class="tb2-sep"></div>
        <select onchange="changeFont(this.value)">
          <option>MS Mincho</option><option>MS Gothic</option>
          <option>Noto Serif JP</option><option>Noto Sans JP</option>
          <option>Times New Roman</option><option>Arial</option>
          <option>Georgia</option><option>Lora</option>
          <option>Courier New</option>
        </select>
        <select onchange="applyFontSize(this.value)">
          <option value="10">10</option><option value="12">12</option>
          <option value="14" selected>14</option><option value="16">16</option>
          <option value="18">18</option><option value="24">24</option>
          <option value="32">32</option><option value="48">48</option>
          <option value="72">72</option>
        </select>
        <select onchange="applyLineHeight(this.value)" title="Giãn dòng">
          <option value="1.4">1.4×</option>
          <option value="1.6">1.6×</option>
          <option value="1.8" selected>1.8×</option>
          <option value="2.0">2.0×</option>
          <option value="2.4">2.4×</option>
        </select>
        <div class="tb2-sep"></div>

        <!-- TEXT COLOR -->
        <div class="color-tool-group" style="position:relative;" id="textColorGroup">
          <button class="color-tool-main" onclick="applyTextColor()" title="Tô màu chữ">
            <span style="font-weight:bold;font-size:14px;line-height:1;font-family:serif;">A</span>
            <div class="color-bar" id="textColorBar" style="background:#e53935;"></div>
          </button>
          <button class="color-tool-arrow" onclick="toggleColorPicker('textColorPicker','textColorGroup')" title="Chọn màu chữ">▾</button>
          <div class="color-picker-popup" id="textColorPicker">
            <div class="color-section-label">Màu chuẩn</div>
            <div class="color-swatches" id="textSwatches"></div>
            <div class="color-section-label">Màu tùy chỉnh</div>
            <div class="custom-color-row" id="textCustomColors"></div>
            <div class="color-custom-row">
              <label>Thêm màu (hex hoặc rgb):</label>
              <input type="color" id="textColorCustom" value="#e53935">
              <input type="text" id="textColorHex" placeholder="#e53935 hoặc rgb(229,57,53)" value="#e53935">
              <button onclick="addCustomTextColor()">+ Thêm</button>
            </div>
            <div style="display:flex;gap:6px;margin-top:6px;">
              <button onclick="applyTextColor();closeAllColorPickers();" style="flex:1;padding:4px;font-size:11px;border-radius:4px;border:1px solid var(--input-border);cursor:pointer;background:var(--accent);color:white;">Áp dụng màu đang chọn</button>
              <button onclick="removeTextColor();closeAllColorPickers();" style="flex:1;padding:4px;font-size:11px;border-radius:4px;border:1px solid var(--input-border);cursor:pointer;background:#e53935;color:white;">✕ Xóa màu chữ</button>
            </div>
          </div>
        </div>

        <!-- HIGHLIGHT -->
        <div class="color-tool-group" style="position:relative;" id="highlightGroup">
          <button class="color-tool-main" onclick="applyHighlight()" title="Highlight">
            <span style="font-size:13px;line-height:1;">🖊</span>
            <div class="color-bar" id="highlightBar" style="background:#FFFF00;"></div>
          </button>
          <button class="color-tool-arrow" onclick="toggleColorPicker('highlightPicker','highlightGroup')" title="Chọn màu highlight">▾</button>
          <div class="color-picker-popup" id="highlightPicker">
            <div class="color-section-label">Màu chuẩn</div>
            <div class="color-swatches" id="hlSwatches"></div>
            <div class="color-section-label">Màu tùy chỉnh</div>
            <div class="custom-color-row" id="hlCustomColors"></div>
            <div class="color-custom-row">
              <label>Thêm màu (hex hoặc rgb):</label>
              <input type="color" id="highlightCustom" value="#FFFF00">
              <input type="text" id="highlightHex" placeholder="#FFFF00 hoặc rgb(255,255,0)" value="#FFFF00">
              <button onclick="addCustomHighlight()">+ Thêm</button>
            </div>
            <div style="display:flex;gap:6px;margin-top:6px;">
              <button onclick="applyHighlight();closeAllColorPickers();" style="flex:1;padding:4px;font-size:11px;border-radius:4px;border:1px solid var(--input-border);cursor:pointer;background:var(--accent);color:white;">Áp dụng màu đang chọn</button>
              <button onclick="removeHighlight();closeAllColorPickers();" style="flex:1;padding:4px;font-size:11px;border-radius:4px;border:1px solid var(--input-border);cursor:pointer;background:#e53935;color:white;">✕ Xóa highlight</button>
            </div>
          </div>
        </div>

        <div class="tb2-sep"></div>
        <button onclick="insertTable()" title="Chèn bảng">⊞ Table</button>
        <button onclick="insertImage()" title="Chèn ảnh">🖼</button>
        <button onclick="toggleFindBar()" title="Tìm & thay thế">🔍</button>
        <div class="tb2-sep"></div>
        <button onclick="customMargin()">Margin</button>
        <button onclick="customPageSize()">PageSize</button>
        <span id="wordCount">0 từ</span>
        <div class="tb2-sep"></div>
        <button onclick="printEditor()" style="background:#222;color:white;border-color:#222;">🖨 Print</button>
        <button onclick="saveNotesDeck()" style="background:#2c5f2e;color:white;border-color:#2c5f2e;">💾 Save</button>
      </div>

      <div id="findBar">
        <span style="font-size:11px;color:var(--text-muted)">Tìm:</span>
        <input type="text" id="findInput" placeholder="Tìm văn bản...">
        <span style="font-size:11px;color:var(--text-muted)">Thay:</span>
        <input type="text" id="replaceInput" placeholder="Thay bằng...">
        <button onclick="findNext()">Tiếp</button>
        <button onclick="replaceOne()">Thay 1</button>
        <button onclick="replaceAll()">Thay tất cả</button>
        <button onclick="toggleFindBar()" style="margin-left:auto;">✕</button>
      </div>

      <div id="editorWrap">
        <div id="editor" contenteditable="true" spellcheck="false"
          oninput="updateWordCount();scheduleEditorSnapshot();updateTOC();if(autoSavePending)clearTimeout(autoSavePending);autoSavePending=setTimeout(saveNotesDeck,2000)">
        </div>
      </div>
    </div>
  </div>
</div>

<!-- SELECTION POPUP -->
<div id="selPopup"></div>

<!-- NOTE MODAL -->
<div id="noteModal">
  <div id="noteModalBox">
    <h3>📌 Thêm ghi chú vào vùng chọn</h3>
    <label>Nội dung ghi chú</label>
    <textarea id="noteText" placeholder="Nhập ghi chú...&#10;(Hover chuột vào text sẽ hiện tooltip)"></textarea>
    <label>Màu ghi chú</label>
    <div class="note-color-row" id="noteColorRow"></div>
    <div class="note-modal-btns">
      <button onclick="closeNoteModal()" style="background:var(--tag-bg);color:var(--text-main);">Huỷ</button>
      <button onclick="saveNote()" style="background:var(--accent);color:white;">Lưu</button>
    </div>
  </div>
</div>

<!-- RENAME MODAL -->
<div id="renameModal">
  <div id="renameModalBox">
    <h3 id="renameModalTitle">✏️ Đổi tên</h3>
    <input type="text" id="renameInput" placeholder="Nhập tên mới...">
    <div class="rename-btns">
